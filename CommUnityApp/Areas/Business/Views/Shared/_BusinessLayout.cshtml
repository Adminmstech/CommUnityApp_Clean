<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Business Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        :root {
            --sidebar-bg: #0b0f19;
            --sidebar-hover: #111827;
            --sidebar-active: #172554;
            --sidebar-link: #a9c7eb;
            --sidebar-link-active: #dbeafe;
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --accent: #0ea5e9;
            --success: #15803d;
            --danger: #b91c1c;
            --warning: #ca8a04;
            --info: #0369a1;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --bg-light: #eef4fb;
            --surface: #ffffff;
            --border: #cbd5e1;
            --table-head: #172554;
            --table-head-border: #1e3a8a;
        }

        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: var(--bg-light);
            color: var(--text-main);
        }

        .layout {
            display: flex;
            height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: var(--sidebar-bg);
            color: #fff;
            padding: 22px 16px;
            flex-shrink: 0;
            transition: all .3s ease;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            border-right: 1px solid rgba(255,255,255,.08);
        }

        .sidebar.collapsed {
            width: 0;
            padding: 0;
            overflow: hidden;
        }

        .brand {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 28px;
            color: #f9fafb;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 12px;
        }

        .brand i {
            color: #93c5fd !important;
        }

        .nav-section-title {
            color: #9ca3af;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            margin: 18px 12px 8px;
            text-transform: uppercase;
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 44px;
            padding: 11px 13px;
            border-radius: 8px;
            color: var(--sidebar-link);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s;
        }

        .nav a:hover, .nav a.active {
            background: var(--sidebar-hover);
            color: var(--sidebar-link-active);
        }

        .nav a.active {
            background: var(--sidebar-active);
            color: var(--sidebar-link-active);
        }

        .nav i {
            width: 20px;
            text-align: center;
            font-size: 18px;
        }

        .main {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            background: var(--bg-light);
        }

        .topbar {
            height: 68px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 28px;
            flex-shrink: 0;
            box-shadow: 0 1px 2px rgba(17,24,39,.04);
        }

        .top-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .menu-btn {
            font-size: 20px;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
        }

        .page-title {
            font-weight: 700;
            font-size: 20px;
            color: var(--text-main);
        }

        .content {
            flex: 1;
            min-width: 0;
            overflow-y: auto;
            padding: 28px;
        }

        .content .container,
        .content .container-fluid {
            max-width: 100%;
            padding-left: 0;
            padding-right: 0;
        }

        .content h1,
        .content h2,
        .content h3 {
            color: var(--text-main);
            font-weight: 700;
            letter-spacing: 0;
        }

        .content h2 {
            font-size: 24px;
        }

        .content h3 {
            font-size: 22px;
        }

        .card {
            border: 1px solid var(--border) !important;
            border-radius: 8px !important;
            box-shadow: 0 10px 30px rgba(17,24,39,.06) !important;
        }

        .card-header {
            border-bottom: 1px solid var(--border);
            border-radius: 8px 8px 0 0 !important;
            font-weight: 700;
        }

        .content .bg-primary,
        .modal-header.bg-primary,
        .btn-primary {
            background-color: var(--primary) !important;
            border-color: var(--primary) !important;
        }

        .btn-primary:hover,
        .btn-primary:focus {
            background-color: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
        }

        .btn,
        .form-control,
        .form-select {
            border-radius: 8px;
        }

        .form-control,
        .form-select {
            border-color: var(--border);
            color: var(--text-main);
            min-height: 42px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 .2rem rgba(37,99,235,.16);
        }

        .table-responsive {
            border: 1px solid var(--border);
            border-radius: 8px;
            width: 100%;
            max-width: 100%;
            overflow-x: auto;
            background: var(--surface);
            -webkit-overflow-scrolling: touch;
        }

        .table {
            margin-bottom: 0;
            color: var(--text-main);
            vertical-align: middle;
        }

        .table-responsive > .table {
            min-width: max-content;
        }

        .table-bordered > :not(caption) > * {
            border-width: 0;
        }

        .table > :not(caption) > * > * {
            padding: 13px 16px;
            border-bottom-color: #e5e7eb;
            vertical-align: middle;
        }

        .table thead,
        .table thead th,
        .table .table-dark th {
            background-color: var(--table-head) !important;
            border-color: var(--table-head-border) !important;
            color: #f9fafb !important;
        }

        .table thead th {
            font-size: 12px;
            font-weight: 700;
            line-height: 1.2;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .table tbody td {
            font-size: 14px;
            line-height: 1.35;
            white-space: nowrap;
        }

        .table tbody tr:hover > * {
            background-color: #f8fafc;
        }

        .table .cell-wrap,
        .table td.text-wrap {
            min-width: 220px;
            white-space: normal;
        }

        .table .cell-strong {
            color: var(--text-main);
            font-weight: 700;
        }

        .table .cell-muted {
            color: var(--text-muted);
            font-size: 12px;
        }

        .table .cell-money {
            color: var(--success);
            font-weight: 700;
            text-align: right;
            white-space: nowrap;
        }

        .table .cell-actions {
            text-align: center;
            white-space: nowrap;
        }

        .table .cell-actions .btn,
        .table td:last-child .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-width: 36px;
            min-height: 34px;
            white-space: nowrap;
        }

        .badge {
            border-radius: 999px;
            font-weight: 700;
            padding: .42rem .62rem;
        }

        .badge.bg-info {
            background-color: #e0f2fe !important;
            color: #075985 !important;
        }

        .badge.bg-success {
            background-color: #dcfce7 !important;
            color: #166534 !important;
        }

        .badge.bg-danger {
            background-color: #fee2e2 !important;
            color: #991b1b !important;
        }

        .badge.bg-warning {
            background-color: #fef3c7 !important;
            color: #92400e !important;
        }

        .badge.bg-secondary {
            background-color: #e5e7eb !important;
            color: #374151 !important;
        }

        .business-avatar {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: var(--primary);
            color: white;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .business-form-card .card-header {
            background: #172554 !important;
            color: #fff;
        }

        .business-form-card .form-label,
        .business-form-card label {
            color: var(--text-main);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .business-form-card textarea.form-control {
            min-height: 112px;
        }

        .business-form-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            padding-top: 4px;
        }

        .footer {
            height: 48px;
            background: var(--surface);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: var(--text-muted);
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: fixed;
                top: 0;
                left: -260px;
                height: 100vh;
                z-index: 1100;
            }
            .sidebar.open { left: 0; }
            .mobile-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15,23,42,.5);
                z-index: 1000;
                display: none;
            }
            .mobile-overlay.show { display: block; }

            .content {
                padding: 18px;
            }

            .topbar {
                padding: 0 16px;
            }

            .page-title {
                font-size: 17px;
            }

            .table > :not(caption) > * > * {
                padding: 11px 12px;
            }
        }
    </style>
</head>
<body>

    <div class="mobile-overlay" id="overlay" onclick="closeSidebar()"></div>

    <div class="layout">
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <i class="fa-solid fa-briefcase text-primary"></i>
                <span>Business Portal</span>
            </div>

            <nav class="nav">
                <a href="@Url.Action("BusinessPromotions", "Home", new { area = "Business" })">
                    <i class="fa-solid fa-bullhorn"></i> Promotions
                </a>
                <a href="@Url.Action("BusinessCustomers", "Home", new { area = "Business" })">
                    <i class="fa-solid fa-users"></i> Customers
                </a>
                <a href="@Url.Action("Communication", "Home", new { area = "Business" })">
                    <i class="fa-solid fa-bullhorn"></i> Communication
                </a>

                <a href="@Url.Action("BusinessPosts", "Home", new { area = "Business" })">
                    <i class="fa-solid fa-newspaper"></i> Business Updates
                </a>

                <a href="@Url.Action("Campaigns", "Home", new { area = "Business" })">
                    <i class="fa-solid fa-bullseye"></i> Campaigns
                </a>

                <a href="@Url.Action("CoinManagement", "Home", new { area = "Business" })">
                    <i class="fa-solid fa-coins"></i> Coin Management
                </a>

                <a href="@Url.Action("BusinessProfile", "Home", new { area = "Business" })">
                    <i class="fa-solid fa-gear"></i> Profile Settings
                </a>
            </nav>

            <div class="mt-auto">
                <a href="@Url.Action("Logout", "Account", new { area = "Business" })" class="nav-link text-danger fw-bold d-flex align-items-center gap-2 px-3">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </a>
            </div>
        </aside>

        <div class="main">
            <header class="topbar">
                <div class="top-left">
                    <button class="menu-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
                    <span class="page-title">@ViewData["Title"]</span>
                </div>

                <div class="dropdown">
                    <button class="btn btn-light d-flex align-items-center gap-2 fw-bold" data-bs-toggle="dropdown">
                        <div class="business-avatar">
                            @(Context.Session.GetString("BusinessName")?.Substring(0,1) ?? "B")
                        </div>
                        @(Context.Session.GetString("BusinessName") ?? "Business")
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="@Url.Action("BusinessProfile", "Home", new { area = "Business" })">My Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account", new { area = "Business" })">Logout</a></li>
                    </ul>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>

            <footer class="footer">
                &copy; 2026 Adminmstech Business Inc. All rights reserved.
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("overlay");

        function toggleSidebar() {
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle("open");
                overlay.classList.toggle("show");
            } else {
                sidebar.classList.toggle("collapsed");
            }
        }

        function closeSidebar() {
            sidebar.classList.remove("open");
            overlay.classList.remove("show");
        }

        window.businessUi = {
            escape(value) {
                return String(value ?? "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            },
            list(response) {
                if (Array.isArray(response)) return response;
                if (Array.isArray(response?.data)) return response.data;
                if (Array.isArray(response?.Data)) return response.Data;
                return [];
            },
            date(value, includeTime = false) {
                if (!value) return "-";
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return "-";
                return includeTime
                    ? date.toLocaleDateString() + " " + date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
                    : date.toLocaleDateString();
            },
            money(value, currency = "$") {
                const amount = Number(value || 0).toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                return `${currency}${amount}`;
            },
            empty(colspan, message) {
                return `<tr><td colspan="${colspan}" class="text-center text-muted p-4">${this.escape(message)}</td></tr>`;
            },
            error(colspan, message) {
                return `<tr><td colspan="${colspan}" class="text-center text-danger p-4">${this.escape(message)}</td></tr>`;
            }
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
