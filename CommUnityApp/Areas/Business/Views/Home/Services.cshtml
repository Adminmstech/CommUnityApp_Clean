@{
    ViewData["Title"] = "My Services";
    Layout = "_BusinessLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">
            <i class="fa-solid fa-concierge-bell me-2"></i>
            Services
        </h3>

        <a href="/Business/Home/AddService" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i>
            Add Service
        </a>
    </div>

    <input type="hidden" id="BusinessId" value="@ViewBag.BusinessId" />

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Service</th>
                            <th>Category</th>
                            <th>Sub Category</th>
                            <th>Price</th>
                            <th>Duration</th>
                            <th>Booking</th>
                            <th>Status</th>
                            <th>Rating</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="serviceTableBody">
                        <tr>
                            <td colspan="11" class="text-center p-4">Loading services...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(loadServices);

        function imagePath(path) {
            if (!path) return "/images/no-image.png";
            if (path.startsWith("http") || path.startsWith("/")) return path;
            return "/" + path;
        }

        function loadServices() {
            const businessId = parseInt($("#BusinessId").val()) || 0;

            if (businessId === 0) {
                $("#serviceTableBody").html(businessUi.error(11, "Business session expired."));
                return;
            }

            $.ajax({
                url: "/api/Service/Get_ServicesByBusinessId?businessId=" + encodeURIComponent(businessId),
                type: "GET",
                success: function (response) {
                    bindServices(businessUi.list(response));
                },
                error: function () {
                    $("#serviceTableBody").html(businessUi.error(11, "Failed to load services."));
                }
            });
        }

        function bindServices(data) {
            if (!data.length) {
                $("#serviceTableBody").html(businessUi.empty(11, "No services found."));
                return;
            }

            const rows = data.map(item => `
                <tr>
                    <td>
                        <img src="${imagePath(item.imageUrl)}" style="width:64px;height:64px;object-fit:cover" class="rounded border" />
                    </td>
                    <td class="cell-strong text-wrap">${businessUi.escape(item.serviceName || "-")}</td>
                    <td>${businessUi.escape(item.categoryName || "-")}</td>
                    <td>${businessUi.escape(item.subCategoryName || "-")}</td>
                    <td class="cell-money">₹ ${Number(item.price || 0).toLocaleString()}</td>
                    <td>${item.durationMinutes || 0} min</td>
                    <td>
                        ${item.isBookingRequired ? '<span class="badge bg-success">Required</span>' : '<span class="badge bg-secondary">No</span>'}
                    </td>
                    <td>
                        ${item.isActive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>'}
                    </td>
                    <td><span class="badge bg-warning">${item.rating || 0}</span></td>
                    <td>${businessUi.date(item.createdAt)}</td>
                    <td class="cell-actions">
                        <button class="btn btn-sm btn-primary" onclick="editService(${item.serviceId})">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                    </td>
                </tr>`).join("");

            $("#serviceTableBody").html(rows);
        }

        function editService(serviceId) {
            window.location.href = "/Business/Home/AddService?serviceId=" + serviceId;
        }
    </script>
}
