@{
    ViewData["Title"] = "Job Applicants";
    Layout = "_BusinessLayout";

    var jobId = Convert.ToInt32(ViewBag.JobId);
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">Job Applicants</h3>

            <p class="text-muted mb-0">
                Applicants who applied for this job
            </p>
        </div>

        <a href="/Business/Home/BusinessJobList"
           class="btn btn-secondary">

            <i class="fa fa-arrow-left"></i>
            Back to Jobs

        </a>

    </div>


    <!-- Job Applicants Card -->

    <div class="card">

        <div class="card-body">

            <!-- Loading -->

            <div id="loading"
                 class="text-center py-4">

                <div class="spinner-border"></div>

                <p class="mt-2">
                    Loading applicants...
                </p>

            </div>


            <!-- No Applicants -->

            <div id="noApplicants"
                 class="text-center py-5"
                 style="display:none;">

                <div class="mb-3">
                    <i class="fa fa-users fa-3x text-muted"></i>
                </div>

                <h5>No Applicants</h5>

                <p class="text-muted">
                    No one has applied for this job yet.
                </p>

            </div>


            <!-- Applicant Table -->

            <div id="applicantTableContainer"
                 class="table-responsive"
                 style="display:none;">

                <table class="table table-bordered table-hover align-middle">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Applicant</th>

                            <th>Email</th>

                            <th>Phone</th>

                            <th>Experience</th>

                            <th>Current Company</th>

                            <th>Current Role</th>

                            <th>Skills</th>

                            <th>Status</th>

                            <th>Applied Date</th>

                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody id="applicantTableBody">
                    </tbody>

                </table>

            </div>


            <!-- Pagination -->

            <div id="paginationContainer"
                 class="d-flex justify-content-between align-items-center mt-3"
                 style="display:none;">

                <div>

                    <span id="paginationInfo"
                          class="text-muted">
                    </span>

                </div>

                <div>

                    <ul id="pagination"
                        class="pagination mb-0">
                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        const jobId = @jobId;
        const businessId = @(ViewBag.BusinessId ?? 0);
        let currentPage = 1;
        const pageSize = 10;
        let isUpdatingStatus = false;

        $(document).ready(function () {
            if (!Number.isInteger(Number(jobId)) || Number(jobId) <= 0) {
                Swal.fire({
                    icon: "error",
                    title: "Invalid Job",
                    text: "A valid job ID is required."
                });
                return;
            }

            GetApplicants(1);
        });

        function GetApplicants(pageNumber) {
            if (pageNumber < 1) return;

            currentPage = pageNumber;

            $("#loading").show();
            $("#noApplicants").hide();
            $("#applicantTableContainer").hide();
            $("#paginationContainer").hide();

            $.ajax({
                url: "/api/Job/GetBusinessJobApplicants",
                type: "GET",
                data: {
                    jobId: jobId,
                    pageNumber: pageNumber,
                    pageSize: pageSize
                },
                dataType: "json",

                success: function (response) {
                    console.log("Applicants Response:", response);

                    $("#loading").hide();

                    if (!response || Number(response.resultId) !== 1) {
                        $("#noApplicants").show();
                        return;
                    }

                    if (!Array.isArray(response.data) ||
                        response.data.length === 0) {
                        $("#noApplicants").show();
                        return;
                    }

                    $("#applicantTableContainer").show();

                    RenderApplicants(response.data);

                    RenderPagination(
                        Number(response.totalRecords) || 0,
                        Number(response.pageNumber) || pageNumber,
                        Number(response.pageSize) || pageSize,
                        Number(response.totalPages) || 0
                    );
                },

                error: function (xhr) {
                    $("#loading").hide();

                    console.error(
                        "Get applicants error:",
                        xhr.status,
                        xhr.responseText
                    );

                    Swal.fire({
                        icon: "error",
                        title: "Unable to Load Applicants",
                        text: getErrorMessage(
                            xhr,
                            "Unable to load applicants."
                        )
                    });
                }
            });
        }

       
        function UpdateApplicationStatus(applicationId, status) {
            applicationId = Number(applicationId);

            if (!Number.isInteger(applicationId) || applicationId <= 0) {
                Swal.fire("Error", "Invalid application ID.", "error");
                return;
            }

            status = String(status || "").trim();

            if (status !== "Accepted" && status !== "Rejected") {
                Swal.fire(
                    "Error",
                    "Status must be Accepted or Rejected.",
                    "error"
                );
                return;
            }

            if (isUpdatingStatus) return;

            const actionText =
                status === "Accepted" ? "accept" : "reject";

            Swal.fire({
                title: `Are you sure you want to ${actionText} this application?`,
                text: status === "Accepted"
                    ? "The applicant will be marked as accepted."
                    : "The applicant will be marked as rejected.",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: status === "Accepted"
                    ? "Yes, Accept"
                    : "Yes, Reject",
                cancelButtonText: "Cancel",
                confirmButtonColor: status === "Accepted"
                    ? "#198754"
                    : "#dc3545"
            }).then(function (result) {
                if (!result.isConfirmed) return;

                isUpdatingStatus = true;

                const buttons = $(
                    `button[data-application-id="${applicationId}"]`
                );

                buttons.prop("disabled", true);

                $.ajax({
                    url: "/api/Job/BusinessUpdateApplicationStatus",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",

                    data: JSON.stringify({
                        applicationId: applicationId,
                        status: status,
                        remarks: ""
                    }),

                    success: function (response) {
                        if (response &&
                            Number(response.resultId) === 1) {

                            Swal.fire({
                                icon: "success",
                                title: "Success",
                                text: response.resultMessage ||
                                    "Application status updated successfully."
                            }).then(function () {
                                GetApplicants(currentPage);
                            });
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Update Failed",
                                text: response?.resultMessage ||
                                    "Unable to update application status."
                            });
                        }
                    },

                    error: function (xhr) {
                        console.error(
                            "Update application status error:",
                            xhr.status,
                            xhr.responseText
                        );

                        Swal.fire({
                            icon: "error",
                            title: "Update Failed",
                            text: getErrorMessage(
                                xhr,
                                "Unable to update application status."
                            )
                        });
                    },

                    complete: function () {
                        isUpdatingStatus = false;
                        buttons.prop("disabled", false);
                    }
                });
            });
        }

        function RenderApplicants(applicants) {
            let html = "";

            $.each(applicants, function (index, item) {
                const applicationId = Number(item.applicationId);

                const rowNumber =
                    ((currentPage - 1) * pageSize) + index + 1;

                const originalStatus = item.status || "Applied";
                const status = originalStatus.toLowerCase();

                let statusClass = "bg-secondary";

                if (status === "applied") {
                    statusClass = "bg-primary";
                } else if (status === "accepted") {
                    statusClass = "bg-success";
                } else if (status === "rejected") {
                    statusClass = "bg-danger";
                } else if (status === "shortlisted") {
                    statusClass = "bg-info";
                }

                let actionButtons = `
                            <button type="button"
                                    class="btn btn-sm btn-primary mb-1"
                                    onclick="ViewApplicant(${applicationId})">
                                <i class="fa fa-eye"></i> View
                            </button>`;

                if (status === "applied" || status === "shortlisted") {
                    actionButtons += `
                                <button type="button"
                                        data-application-id="${applicationId}"
                                        class="btn btn-sm btn-success mb-1"
                                        onclick="UpdateApplicationStatus(
                                            ${applicationId}, 'Accepted')">
                                    <i class="fa fa-check"></i> Accept
                                </button>

                                <button type="button"
                                        data-application-id="${applicationId}"
                                        class="btn btn-sm btn-danger mb-1"
                                        onclick="UpdateApplicationStatus(
                                            ${applicationId}, 'Rejected')">
                                    <i class="fa fa-times"></i> Reject
                                </button>`;
                } else if (
                    status === "accepted" ||
                    status === "rejected"
                ) {
                    actionButtons += `
                                <span class="text-muted d-block small">
                                    Decision submitted
                                </span>`;
                }

                html += `
                            <tr>
                                <td>${rowNumber}</td>
                                <td><strong>${escapeHtml(item.fullName)}</strong></td>
                                <td>${escapeHtml(item.email)}</td>
                                <td>${escapeHtml(item.phone)}</td>
                                <td>${escapeHtml(item.totalExperience)}</td>
                                <td>${escapeHtml(item.currentCompany)}</td>
                                <td>${escapeHtml(item.currentRole)}</td>
                                <td>
                                    <span title="${escapeHtml(item.skills)}">
                                        ${escapeHtml(item.skills)}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge ${statusClass}">
                                        ${escapeHtml(originalStatus)}
                                    </span>
                                </td>
                                <td>${formatDateTime(item.appliedDate)}</td>
                                <td style="min-width:180px;">
                                    ${actionButtons}
                                </td>
                            </tr>`;
            });

            $("#applicantTableBody").html(html);
        }

    
        function ViewApplicant(applicationId) {
            window.location.href =
                "/Business/Home/JobApplicantDetails"
                + "?jobId=" + encodeURIComponent(jobId)
                + "&applicationId=" + encodeURIComponent(applicationId);
        }

        function RenderPagination(
            totalRecords,
            pageNumber,
            pageSize,
            totalPages
        ) {
            if (totalPages <= 1) {
                $("#paginationContainer").hide();
                $("#pagination").empty();
                return;
            }

            $("#paginationContainer").show();

            const startRecord = ((pageNumber - 1) * pageSize) + 1;
            const endRecord = Math.min(
                pageNumber * pageSize,
                totalRecords
            );

            $("#paginationInfo").text(
                `Showing ${startRecord} - ${endRecord} of ${totalRecords}`
            );

            let html = `
                        <li class="page-item ${pageNumber <= 1 ? "disabled" : ""}">
                            <a class="page-link"
                               href="javascript:void(0)"
                               onclick="GetApplicants(${pageNumber - 1})">
                                Previous
                            </a>
                        </li>`;

            const startPage = Math.max(1, pageNumber - 2);
            const endPage = Math.min(totalPages, pageNumber + 2);

            for (let i = startPage; i <= endPage; i++) {
                html += `
                            <li class="page-item ${i === pageNumber ? "active" : ""}">
                                <a class="page-link"
                                   href="javascript:void(0)"
                                   onclick="GetApplicants(${i})">
                                    ${i}
                                </a>
                            </li>`;
            }

            html += `
                        <li class="page-item ${pageNumber >= totalPages ? "disabled" : ""}">
                            <a class="page-link"
                               href="javascript:void(0)"
                               onclick="GetApplicants(${pageNumber + 1})">
                                Next
                            </a>
                        </li>`;

            $("#pagination").html(html);
        }

        function formatDateTime(value) {
            if (!value) return "";

            const date = new Date(value);

            if (isNaN(date.getTime())) {
                return escapeHtml(value);
            }

            return date.toLocaleString();
        }

  
        function escapeHtml(value) {
            if (value === null || value === undefined) {
                return "";
            }

            return $("<div>")
                .text(String(value))
                .html();
        }

  
        function getErrorMessage(xhr, fallbackMessage) {
            const response = xhr.responseJSON;

            if (response) {
                return response.resultMessage ||
                    response.message ||
                    response.title ||
                    fallbackMessage;
            }

            if (xhr.status === 401) {
                return "Your session has expired. Please log in again.";
            }

            if (xhr.status === 403) {
                return "You are not authorized to update this application.";
            }

            if (xhr.status === 404) {
                return "The requested API endpoint was not found.";
            }

            if (xhr.status >= 500) {
                return "A server error occurred. Please check the API and SQL logs.";
            }

            return fallbackMessage;
        }
    </script>
}