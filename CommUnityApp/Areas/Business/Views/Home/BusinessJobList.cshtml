@{
    ViewData["Title"] = "My Job Posts";
    Layout = "_BusinessLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">My Job Posts</h3>

            <p class="text-muted mb-0">
                Manage jobs posted by your business
            </p>
        </div>

        <a href="/Business/Home/BusinessPostJob"
           class="btn btn-success">

            <i class="fa fa-plus"></i>
            Post New Job

        </a>

    </div>


    <div class="card">

        <div class="card-body">

            <!-- Loading -->

            <div id="loading"
                 class="text-center py-4">

                <div class="spinner-border"></div>

                <p class="mt-2">
                    Loading jobs...
                </p>

            </div>


            <!-- No Jobs -->

            <div id="noJobs"
                 class="text-center py-5"
                 style="display:none;">

                <h5>No Jobs Posted</h5>

                <p class="text-muted">
                    You haven't posted any jobs yet.
                </p>

                <a href="/Business/Home/BusinessPostJob"
                   class="btn btn-success">

                    Post Your First Job

                </a>

            </div>


            <!-- Job Table -->

            <div id="jobTableContainer"
                 class="table-responsive"
                 style="display:none;">

                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Job Title</th>
                            <th>Job Type</th>
                            <th>Experience</th>
                            <th>Salary</th>
                            <th>Location</th>
                            <th>Remote</th>
                            <th>Last Date</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th>Applicants</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="jobTableBody">
                    </tbody>

                </table>

            </div>


            <!-- Pagination -->

            <div id="paginationContainer"
                 class="d-flex justify-content-between align-items-center mt-3"
                 style="display:none !important;">

                <div>

                    <span id="paginationInfo"
                          class="text-muted">
                    </span>

                </div>

                <div>

                    <ul id="pagination"
                        class="pagination mb-0">
                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Interested Members Modal -->



@section Scripts {

<script>

    let currentPage = 1;

    const pageSize = 10;


    $(document).ready(function () {

        GetBusinessJobs(1);

    });



    function GetBusinessJobs(pageNumber) {

        currentPage = pageNumber;

        $("#loading").show();

        $("#noJobs").hide();

        $("#jobTableContainer").hide();

        $("#paginationContainer").hide();

        $.ajax({

            url:
                "/api/Job/GetBusinessJobPosts" +
                "?pageNumber=" + pageNumber +
                "&pageSize=" + pageSize,

            type: "GET",

            success: function (response) {

                console.log("Job API Response:", response);

                $("#loading").hide();


                if (
                    !response ||
                    response.resultId !== 1 ||
                    !response.data ||
                    response.data.length === 0
                ) {

                    $("#noJobs").show();

                    return;
                }


                $("#jobTableContainer").show();

                RenderJobs(response.data);

                RenderPagination(
                    response.totalRecords,
                    response.pageNumber,
                    response.pageSize,
                    response.totalPages
                );

            },

            error: function (xhr) {

                $("#loading").hide();

                console.log(
                    "Job API Error:",
                    xhr.responseText
                );

                let message =
                    "Unable to load jobs.";


                try {

                    const errorResponse =
                        JSON.parse(xhr.responseText);

                    if (errorResponse.resultMessage) {

                        message =
                            errorResponse.resultMessage;

                    }

                }
                catch (e) {
                }


                Swal.fire({

                    icon: "error",

                    title: "Error",

                    text: message

                });

            }

        });

    }



        function RenderJobs(jobs) {

            let html = "";

            $.each(jobs, function (index, item) {

                const rowNumber =
                    ((currentPage - 1) * pageSize)
                    + index + 1;


                const salary =
                    formatSalary(item.salaryMin)
                    + " - "
                    + formatSalary(item.salaryMax);


                const remote =
                    item.isRemote

                        ? '<span class="badge bg-success">Remote</span>'

                        : '<span class="badge bg-secondary">On-site</span>';


                const statusClass =
                    item.status === "Active"

                        ? "bg-success"

                        : "bg-secondary";


                html += `

                    <tr>

                        <td>
                            ${rowNumber}
                        </td>


                        <td>
                            <strong>
                                ${escapeHtml(item.jobTitle)}
                            </strong>
                        </td>


                        <td>
                            ${escapeHtml(item.jobType)}
                        </td>


                        <td>
                            ${escapeHtml(item.experience)}
                        </td>


                        <td>
                            ${salary}
                        </td>


                        <td>
                            ${escapeHtml(item.location)}
                        </td>


                        <td>
                            ${remote}
                        </td>


                        <td>
                            ${formatDate(item.lastDateToApply)}
                        </td>


                        <td>

                            <span class="badge ${statusClass}">
                                ${escapeHtml(item.status)}
                            </span>

                        </td>


                        <td>
                            ${formatDateTime(item.createdDate)}
                        </td>


                        <!-- APPLICANTS -->

                        <td>

                            <button type="button"
                                    class="btn btn-sm btn-info"
                                    onclick="ViewApplicants(${item.jobId})">

                                <i class="fa fa-users"></i>

                                Applicants

                            </button>

                        </td>


                        <!-- ACTION -->

                        <td>

                            <div class="d-flex gap-1">

                                <button type="button"
                                        class="btn btn-sm btn-primary"
                                        onclick="EditJob(${item.jobId})"
                                        title="Edit Job">

                                    <i class="fa fa-edit"></i>

                                </button>


                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        onclick="DeleteJob(${item.jobId})"
                                        title="Delete Job">

                                    <i class="fa fa-trash"></i>

                                </button>

                            </div>

                        </td>

                    </tr>

                `;

            });


            $("#jobTableBody").html(html);

        }

        function ViewApplicants(jobId) {

            window.location.href =
                "/Business/Home/JobApplicants?jobId=" + jobId;

        }


    function RenderPagination(
        totalRecords,
        pageNumber,
        pageSize,
        totalPages) {


        if (totalPages <= 1) {

            $("#paginationContainer")
                .hide();

            return;

        }


        $("#paginationContainer")
            .show()
            .css("display", "flex");


        const startRecord =
            ((pageNumber - 1) * pageSize) + 1;


        const endRecord =
            Math.min(
                pageNumber * pageSize,
                totalRecords
            );


        $("#paginationInfo").text(

            "Showing " +
            startRecord +
            " - " +
            endRecord +
            " of " +
            totalRecords

        );


        let html = "";



        html += `

            <li class="page-item
                ${pageNumber === 1 ? "disabled" : ""}">

                <a class="page-link"
                   href="javascript:void(0)"
                   onclick="GetBusinessJobs(${pageNumber - 1})">

                    Previous

                </a>

            </li>

        `;



        let startPage =
            Math.max(1, pageNumber - 2);

        let endPage =
            Math.min(totalPages, pageNumber + 2);


        for (
            let i = startPage;
            i <= endPage;
            i++
        ) {

            html += `

                <li class="page-item
                    ${i === pageNumber ? "active" : ""}">

                    <a class="page-link"
                       href="javascript:void(0)"
                       onclick="GetBusinessJobs(${i})">

                        ${i}

                    </a>

                </li>

            `;

        }



        html += `

            <li class="page-item
                ${pageNumber === totalPages ? "disabled" : ""}">

                <a class="page-link"
                   href="javascript:void(0)"
                   onclick="GetBusinessJobs(${pageNumber + 1})">

                    Next

                </a>

            </li>

        `;


        $("#pagination").html(html);

    }



    function EditJob(jobId) {

        window.location.href =
            "/Business/Home/BusinessPostJob?jobId="
            + jobId;

    }


    function DeleteJob(jobId) {

        Swal.fire({

            title: "Delete Job?",

            text:
                "Are you sure you want to delete this job?",

            icon: "warning",

            showCancelButton: true,

            confirmButtonColor: "#d33",

            cancelButtonColor: "#6c757d",

            confirmButtonText:
                "Yes, delete it!"

        }).then(function (result) {

            if (!result.isConfirmed)
                return;


            $.ajax({

                url:
                    "/api/Job/DeleteBusinessJobPost/"
                    + jobId,

                type: "DELETE",

                success: function (response) {

                    if (
                        response &&
                        response.resultId === 1
                    ) {

                        Swal.fire({

                            icon: "success",

                            title: "Deleted",

                            text:
                                response.resultMessage

                        }).then(function () {

                            GetBusinessJobs(
                                currentPage
                            );

                        });

                    }
                    else {

                        Swal.fire({

                            icon: "error",

                            title: "Error",

                            text:
                                response.resultMessage
                                || "Unable to delete job."

                        });

                    }

                },

                error: function (xhr) {

                    console.log(
                        xhr.responseText
                    );


                    let message =
                        "Unable to delete job.";


                    try {

                        const response =
                            JSON.parse(
                                xhr.responseText
                            );

                        if (
                            response.resultMessage
                        ) {

                            message =
                                response.resultMessage;

                        }

                    }
                    catch (e) {
                    }


                    Swal.fire({

                        icon: "error",

                        title: "Error",

                        text: message

                    });

                }

            });

        });

    }



    function formatSalary(value) {

        if (
            value === null ||
            value === undefined
        ) {

            return "0";

        }


        return Number(value)
            .toLocaleString();

    }


    function formatDate(value) {

        if (!value)
            return "";


        const date =
            new Date(value);


        if (isNaN(date))
            return value;


        return date.toLocaleDateString();

    }


    function formatDateTime(value) {

        if (!value)
            return "";


        const date =
            new Date(value);


        if (isNaN(date))
            return value;


        return date.toLocaleString();

    }


    function escapeHtml(value) {

        if (
            value === null ||
            value === undefined
        ) {

            return "";

        }


        return $("<div>")
            .text(value)
            .html();

    }

</script>

}