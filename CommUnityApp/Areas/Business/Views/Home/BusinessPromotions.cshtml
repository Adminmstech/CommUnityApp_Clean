@{
    ViewData["Title"] = "My Promotions";
    Layout = "_BusinessLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">
            <i class="fa-solid fa-tags me-2"></i>
            Promotions
        </h3>

        <a href="/Business/Home/AddPromotion" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i>
            Add Promotion
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Image</th>
                            <th>Promotion</th>
                            <th>Products</th>
                            <th>Offer</th>
                            <th>Price</th>
                            <th>Coins</th>
                            <th>Friend Reward</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>QR Code</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="promotionTableBody">
                        <tr>
                            <td colspan="13" class="text-center p-4">Loading promotions...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="qrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Promotion QR Code</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="qrPreview" class="img-fluid rounded shadow" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const businessId = @ViewBag.BusinessId;

        $(document).ready(loadPromotions);

        function imagePath(path) {
            if (!path) return "/images/no-image.png";
            if (path.startsWith("http") || path.startsWith("/")) return path;
            return "/" + path;
        }

        function loadPromotions() {
            $.ajax({
                url: "/api/Product/Get_BusinessPromotions?businessId=" + encodeURIComponent(businessId),
                type: "GET",
                success: function (response) {
                    bindPromotions(businessUi.list(response));
                },
                error: function () {
                    $("#promotionTableBody").html(businessUi.error(13, "Failed to load promotions."));
                }
            });
        }

        function bindPromotions(data) {
            if (!data.length) {
                $("#promotionTableBody").html(businessUi.empty(13, "No promotions found."));
                return;
            }

            const rows = data.map((item, index) => {
                const promotionImage = imagePath(item.promotionImage);
                const qrImage = imagePath(item.qrCodeImage);
                const title = businessUi.escape(item.promotionTitle || "-");
                const product = businessUi.escape(item.featuredProducts || item.productName || "-");
                const offer = businessUi.escape(item.offerHeadline || "-");
                const shareUrl = businessUi.escape(item.promotionUrl || "");

                return `
                    <tr>
                        <td>${index + 1}</td>
                        <td class="text-center">
                            <img src="${promotionImage}" class="rounded border" style="width:64px;height:64px;object-fit:cover;" />
                        </td>
                        <td class="cell-strong text-wrap">${title}</td>
                        <td class="text-wrap">${product}</td>
                        <td class="text-wrap">${offer}</td>
                        <td class="cell-money">${businessUi.money(item.promotionalPrice || item.actualPrice || 0)}</td>
                        <td>${item.indoCoinsEarned || 0}</td>
                        <td>${item.friendRewardCoins || 0}</td>
                        <td>${businessUi.date(item.startDate)}</td>
                        <td>${businessUi.date(item.endDate)}</td>
                        <td class="text-center">
                            ${item.qrCodeImage ? `<img src="${qrImage}" class="rounded border bg-white p-1" style="width:72px;height:72px;object-fit:contain;cursor:pointer;" onclick="showQR('${qrImage}')" />` : "-"}
                        </td>
                        <td>
                            ${item.isActive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>'}
                        </td>
                        <td class="cell-actions">
                            <button class="btn btn-primary btn-sm" onclick="viewPromotion(${item.promotionId})">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                            <button class="btn btn-success btn-sm" ${shareUrl ? `onclick="sharePromotion('${shareUrl}')"` : "disabled"}>
                                <i class="fa-solid fa-share-nodes"></i>
                            </button>
                            <button class="btn btn-warning btn-sm" onclick="editPromotion(${item.promotionId}, ${item.businessId || businessId})">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="deletePromotion(${item.promotionId})">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>`;
            }).join("");

            $("#promotionTableBody").html(rows);
        }

        function showQR(imageUrl) {
            $("#qrPreview").attr("src", imageUrl);
            new bootstrap.Modal(document.getElementById("qrModal")).show();
        }

        function sharePromotion(url) {
            window.open("https://wa.me/?text=" + encodeURIComponent(url), "_blank");
        }

        function viewPromotion(id) {
            window.location.href = "/Business/Home/PromotionDetails?promotionId=" + id;
        }

        function deletePromotion(id) {
            Swal.fire({
                title: "Delete promotion?",
                text: "This promotion will be deleted permanently.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#b91c1c",
                confirmButtonText: "Delete"
            }).then((result) => {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: "/api/Product/DeletePromotion?promotionId=" + id,
                    type: "DELETE",
                    success: function (res) {
                        Swal.fire("Deleted", res.resultMessage || "Promotion deleted.", "success");
                        loadPromotions();
                    },
                    error: function () {
                        Swal.fire("Error", "Unable to delete promotion.", "error");
                    }
                });
            });
        }

        function editPromotion(promotionId, itemBusinessId) {
            window.location.href = "/Business/Home/AddPromotion?businessId=" + itemBusinessId + "&promotionId=" + promotionId;
        }
    </script>
}
