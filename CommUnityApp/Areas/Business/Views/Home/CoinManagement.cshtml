@{
    ViewData["Title"] = "Coin Management";
    Layout = "_BusinessLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">
            <i class="fa-solid fa-coins me-2"></i>
            Coin Management
        </h3>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="text-muted">Available Coins</h6>
                    <h2 id="availableCoins" class="text-success mb-0">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="text-muted">Allocated Coins</h6>
                    <h2 id="allocatedCoins" class="text-primary mb-0">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="text-muted">Coins Spent</h6>
                    <h2 id="spentCoins" class="text-danger mb-0">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h6 class="text-muted">Users Rewarded</h6>
                    <h2 id="usersRewarded" class="text-warning mb-0">0</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">Reward Configuration</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Promotion Share Coins</label>
                    <input type="number" id="promotionCoins" class="form-control" min="0" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Product Share Coins</label>
                    <input type="number" id="productCoins" class="form-control" min="0" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Referral Coins</label>
                    <input type="number" id="referralCoins" class="form-control" min="0" />
                </div>
            </div>

            <button id="btnSaveConfig" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk me-1"></i>
                Save Configuration
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">Wallet Transactions</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Coins</th>
                            <th>Reference Type</th>
                            <th>Reference Id</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody id="walletTransactionsBody">
                        <tr>
                            <td colspan="6" class="text-center p-4">Loading transactions...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-5">
        <div class="card-header bg-primary text-white">Share Reward History</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Promotion</th>
                            <th>Product</th>
                            <th>Platform</th>
                            <th>Reward Coins</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody id="rewardHistoryBody">
                        <tr>
                            <td colspan="6" class="text-center p-4">Loading reward history...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const businessId = '@ViewBag.BusinessId';

        $(document).ready(function () {
            loadWallet();
            loadDashboard();
            loadRewardConfig();
            loadTransactions();
            loadRewardHistory();
        });

        function numberText(value) {
            return Number(value || 0).toLocaleString();
        }

        function loadWallet() {
            $.get('/api/Business/GetBusinessWallet?businessId=' + encodeURIComponent(businessId))
                .done(function (response) {
                    const wallet = response.data || response.Data || response;
                    $('#availableCoins').text(numberText(wallet?.availableCoins));
                })
                .fail(function () {
                    $('#availableCoins').text("0");
                });
        }

        function loadDashboard() {
            $.get('/api/Business/GetRewardsDashboard?businessId=' + encodeURIComponent(businessId))
                .done(function (response) {
                    $('#allocatedCoins').text(numberText(response.totalAllocatedCoins));
                    $('#spentCoins').text(numberText(response.totalRewardCoinsSpent));
                    $('#usersRewarded').text(numberText(response.totalUsersRewarded));
                });
        }

        function loadRewardConfig() {
            $.get('/api/Rewards/GetShareRewardConfig?businessId=' + encodeURIComponent(businessId))
                .done(function (response) {
                    $('#promotionCoins').val(response.promotionShareCoins || 0);
                    $('#productCoins').val(response.productShareCoins || 0);
                    $('#referralCoins').val(response.referralCoins || 0);
                });
        }

        $('#btnSaveConfig').click(function () {
            const model = {
                businessId: parseInt(businessId),
                promotionShareCoins: parseInt($('#promotionCoins').val()) || 0,
                productShareCoins: parseInt($('#productCoins').val()) || 0,
                referralCoins: parseInt($('#referralCoins').val()) || 0
            };

            $.ajax({
                url: '/api/Rewards/SaveShareRewardConfig',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (response) {
                    Swal.fire("Saved", response.resultMessage || "Configuration saved.", "success");
                },
                error: function () {
                    Swal.fire("Error", "Failed to save configuration.", "error");
                }
            });
        });

        function loadTransactions() {
            $.get('/api/Business/GetBusinessWalletTransactions?businessId=' + encodeURIComponent(businessId))
                .done(function (response) {
                    const data = businessUi.list(response);

                    if (!data.length) {
                        $('#walletTransactionsBody').html(businessUi.empty(6, "No transactions found."));
                        return;
                    }

                    const rows = data.map(item => `
                        <tr>
                            <td>${businessUi.date(item.createdAt, true)}</td>
                            <td><span class="badge bg-secondary">${businessUi.escape(item.transactionType || "-")}</span></td>
                            <td class="cell-money">${numberText(item.coins)}</td>
                            <td>${businessUi.escape(item.referenceType || "-")}</td>
                            <td>${item.referenceId || "-"}</td>
                            <td class="text-wrap">${businessUi.escape(item.notes || "-")}</td>
                        </tr>`).join("");

                    $('#walletTransactionsBody').html(rows);
                })
                .fail(function () {
                    $('#walletTransactionsBody').html(businessUi.error(6, "Failed to load transactions."));
                });
        }

        function loadRewardHistory() {
            $.get('/api/Business/GetShareRewardHistory?businessId=' + encodeURIComponent(businessId))
                .done(function (response) {
                    const data = businessUi.list(response);

                    if (!data.length) {
                        $('#rewardHistoryBody').html(businessUi.empty(6, "No reward history found."));
                        return;
                    }

                    const rows = data.map(item => `
                        <tr>
                            <td class="cell-strong">${businessUi.escape(item.userName || "-")}</td>
                            <td>${businessUi.escape(item.promotionName || "-")}</td>
                            <td>${businessUi.escape(item.productName || "-")}</td>
                            <td>${businessUi.escape(item.sharePlatform || "-")}</td>
                            <td class="cell-money">${numberText(item.rewardCoins)}</td>
                            <td>${businessUi.date(item.sharedAt, true)}</td>
                        </tr>`).join("");

                    $('#rewardHistoryBody').html(rows);
                })
                .fail(function () {
                    $('#rewardHistoryBody').html(businessUi.error(6, "Failed to load reward history."));
                });
        }
    </script>
}
