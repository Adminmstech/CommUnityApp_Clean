@{
    ViewData["Title"] = "Business Customers";
    var businessId = ViewBag.BusinessId;
    Layout = "_BusinessLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">
            <i class="fa-solid fa-users me-2"></i>
            Customers
        </h3>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Total Orders</th>
                            <th>Total Spent</th>
                            <th>Last Order</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="customersTable">
                        <tr>
                            <td colspan="7" class="text-center p-4">Loading customers...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const businessId = '@businessId';

        async function loadCustomers() {
            try {
                const response = await fetch(`/api/Business/Get_BusinessCustomer?BusinessId=${encodeURIComponent(businessId)}`);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const data = businessUi.list(await response.json());

                if (!data.length) {
                    document.getElementById("customersTable").innerHTML = businessUi.empty(7, "No customers found.");
                    return;
                }

                const rows = data.map(cust => {
                    const name = businessUi.escape(cust.name || "Customer");
                    const email = businessUi.escape(cust.email || "-");
                    const mobile = businessUi.escape(cust.mobile || "-");

                    return `
                        <tr>
                            <td class="cell-strong">${name}</td>
                            <td>${mobile}</td>
                            <td>${email}</td>
                            <td>${cust.totalOrders || 0}</td>
                            <td class="cell-money">₹ ${Number(cust.totalSpent || 0).toLocaleString()}</td>
                            <td>${businessUi.date(cust.lastOrderDate, true)}</td>
                            <td class="cell-actions">
                                ${cust.email ? `<a class="btn btn-sm btn-primary" href="mailto:${email}"><i class="fa-solid fa-envelope"></i></a>` : "-"}
                            </td>
                        </tr>`;
                }).join("");

                document.getElementById("customersTable").innerHTML = rows;
            } catch (error) {
                console.error("Error loading customers:", error);
                document.getElementById("customersTable").innerHTML = businessUi.error(7, "Failed to load customers.");
            }
        }

        loadCustomers();
    </script>
}
