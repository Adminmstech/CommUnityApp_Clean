@{
    ViewData["Title"] = "Business Orders";
    var businessId = ViewBag.BusinessId;
    Layout = "_BusinessLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">
            <i class="fa-solid fa-clipboard-list me-2"></i>
            Orders
        </h3>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Order Id</th>
                            <th>Customer</th>
                            <th>Total Items</th>
                            <th>Order Amount</th>
                            <th>Coins Used</th>
                            <th>Coins Earned</th>
                            <th>Final Paid</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTable">
                        <tr>
                            <td colspan="10" class="text-center p-4">Loading orders...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const businessId = '@businessId';

        function getStatusClass(status) {
            switch (status) {
                case "Placed": return "bg-primary";
                case "Processing": return "bg-warning";
                case "Shipped": return "bg-info";
                case "Delivered": return "bg-success";
                case "Cancelled": return "bg-danger";
                default: return "bg-secondary";
            }
        }

        async function loadOrders() {
            try {
                const response = await fetch(`/api/Order/Get_BusinessOrders?businessId=${encodeURIComponent(businessId)}`);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const data = businessUi.list(await response.json());

                if (!data.length) {
                    document.getElementById("ordersTable").innerHTML = businessUi.empty(10, "No orders found.");
                    return;
                }

                const rows = data.map(order => `
                    <tr>
                        <td class="cell-strong">#${order.orderId}</td>
                        <td>${businessUi.escape(order.customerName || "-")}</td>
                        <td>${order.totalItems || 0}</td>
                        <td class="cell-money">₹ ${Number(order.orderAmount || 0).toLocaleString()}</td>
                        <td>${order.coinsUsed ?? 0}</td>
                        <td>${order.coinsEarned ?? 0}</td>
                        <td class="cell-money">₹ ${Number(order.finalAmount || 0).toLocaleString()}</td>
                        <td>
                            <select class="form-select form-select-sm ${getStatusClass(order.orderStatus)} text-white"
                                    onchange="updateStatus(${order.orderId}, this.value)">
                                <option value="Placed" ${order.orderStatus === "Placed" ? "selected" : ""}>Placed</option>
                                <option value="Processing" ${order.orderStatus === "Processing" ? "selected" : ""}>Processing</option>
                                <option value="Shipped" ${order.orderStatus === "Shipped" ? "selected" : ""}>Shipped</option>
                                <option value="Delivered" ${order.orderStatus === "Delivered" ? "selected" : ""}>Delivered</option>
                                <option value="Cancelled" ${order.orderStatus === "Cancelled" ? "selected" : ""}>Cancelled</option>
                            </select>
                        </td>
                        <td>${businessUi.date(order.orderDate, true)}</td>
                        <td class="cell-actions">
                            <button class="btn btn-sm btn-primary" onclick="viewDetails(${order.orderId})">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </td>
                    </tr>`).join("");

                document.getElementById("ordersTable").innerHTML = rows;
            } catch (error) {
                console.error("Error loading orders:", error);
                document.getElementById("ordersTable").innerHTML = businessUi.error(10, "Failed to load orders.");
            }
        }

        function viewDetails(orderId) {
            window.location.href = "/Business/Home/OrderDetails?orderId=" + orderId;
        }

        async function updateStatus(orderId, status) {
            try {
                const response = await fetch("/api/Order/Update_OrderStatus", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ orderId, orderStatus: status })
                });

                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                Swal.fire("Updated", "Order status updated.", "success");
                loadOrders();
            } catch (error) {
                console.error("Error updating status:", error);
                Swal.fire("Error", "Failed to update order status.", "error");
            }
        }

        loadOrders();
    </script>
}
