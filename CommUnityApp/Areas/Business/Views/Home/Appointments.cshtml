@{
    ViewData["Title"] = "Appointments";
    var businessId = ViewBag.BusinessId;
    Layout = "_BusinessLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">
            <i class="fa-solid fa-calendar-check me-2"></i>
            Appointments
        </h3>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Service</th>
                            <th>User</th>
                            <th>Email</th>
                            <th>Date</th>
                            <th>Notes</th>
                            <th>Status</th>
                            <th>Update Status</th>
                        </tr>
                    </thead>
                    <tbody id="appointmentTable">
                        <tr>
                            <td colspan="7" class="text-center p-4">Loading appointments...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const businessId = '@businessId';

        function getStatusBadge(status) {
            if (status === "Pending") return `<span class="badge bg-warning">Pending</span>`;
            if (status === "Responded") return `<span class="badge bg-info">Responded</span>`;
            if (status === "Completed") return `<span class="badge bg-success">Completed</span>`;
            if (status === "Cancelled") return `<span class="badge bg-danger">Cancelled</span>`;
            return `<span class="badge bg-secondary">${businessUi.escape(status || "Unknown")}</span>`;
        }

        async function loadAppointments() {
            try {
                const res = await fetch(`/api/Service/Get_BusinessAppointments?BusinessId=${encodeURIComponent(businessId)}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const data = businessUi.list(await res.json());

                if (!data.length) {
                    document.getElementById("appointmentTable").innerHTML = businessUi.empty(7, "No appointments found.");
                    return;
                }

                const rows = data.map(item => `
                    <tr>
                        <td class="cell-strong text-wrap">${businessUi.escape(item.serviceName || "-")}</td>
                        <td>${businessUi.escape(item.userName || "-")}</td>
                        <td>${businessUi.escape(item.email || "-")}</td>
                        <td>${businessUi.date(item.appointmentDateTime, true)}</td>
                        <td class="text-wrap">${businessUi.escape(item.notes || "-")}</td>
                        <td>${getStatusBadge(item.status)}</td>
                        <td>
                            <select class="form-select form-select-sm status-dropdown" data-id="${item.appointmentId}">
                                <option value="Pending" ${item.status === "Pending" ? "selected" : ""}>Pending</option>
                                <option value="Responded" ${item.status === "Responded" ? "selected" : ""}>Responded</option>
                                <option value="Completed" ${item.status === "Completed" ? "selected" : ""}>Completed</option>
                                <option value="Cancelled" ${item.status === "Cancelled" ? "selected" : ""}>Cancelled</option>
                            </select>
                        </td>
                    </tr>`).join("");

                document.getElementById("appointmentTable").innerHTML = rows;
            } catch (err) {
                console.error(err);
                document.getElementById("appointmentTable").innerHTML = businessUi.error(7, "Failed to load appointments.");
            }
        }

        document.addEventListener("change", async function (e) {
            if (!e.target.classList.contains("status-dropdown")) return;

            const id = e.target.getAttribute("data-id");
            const status = e.target.value;

            const confirmation = await Swal.fire({
                title: "Update status?",
                text: "Change appointment status to " + status + ".",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Update"
            });

            if (!confirmation.isConfirmed) {
                loadAppointments();
                return;
            }

            try {
                const res = await fetch("/api/Service/Update_AppointmentStatus", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ appointmentId: parseInt(id), status })
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                Swal.fire("Updated", "Appointment status updated.", "success");
                loadAppointments();
            } catch (err) {
                console.error(err);
                Swal.fire("Error", "Failed to update appointment status.", "error");
                loadAppointments();
            }
        });

        loadAppointments();
    </script>
}
