@model CommUnityApp.ApplicationCore.Models.BusinessJobPostModel
@{
    ViewData["Title"] = "Post Job";
    var businessId = Context.Session.GetString("BusinessId");
    Layout = "_BusinessLayout";
}
<div class="card">
    <div class="card-header">
        <h4 id="pageTitle">Post Job</h4>
    </div>

    <div class="card-body">

        <input type="hidden" id="JobId" value="0" />
        <input type="hidden" id="BusinessId" value="@ViewBag.BusinessId" />
        <input type="hidden" id="GroupId" value="@ViewBag.GroupId" />
        <input type="hidden" id="PostedBy" value="@ViewBag.PostedBy" />

        <div class="row">

            <div class="col-md-6 mb-3">
                <label>Job Title</label>
                <input type="text" id="JobTitle" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Job Type</label>
                <select id="JobType" class="form-control">
                    <option value="">Select</option>
                    <option>FullTime</option>
                    <option>PartTime</option>
                    <option>Contract</option>
                    <option>Casual</option>
                </select>
            </div>

            <div class="col-md-12 mb-3">
                <label>Description</label>
                <textarea id="Description" class="form-control" rows="5"></textarea>
            </div>

            <div class="col-md-6 mb-3">
                <label>Experience</label>
                <input type="text" id="Experience" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Location</label>
                <input type="text" id="Location" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Salary Min</label>
                <input type="number" id="SalaryMin" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Salary Max</label>
                <input type="number" id="SalaryMax" class="form-control" />
            </div>

            <div class="col-md-12 mb-3">
                <label>Skills</label>
                <textarea id="Skills" class="form-control"></textarea>
            </div>

            <div class="col-md-6 mb-3">
                <label>Email</label>
                <input type="email" id="ContactEmail" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Phone</label>
                <input type="text" id="ContactPhone" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Last Date To Apply</label>
                <input type="date" id="LastDateToApply" class="form-control" />
            </div>

            <div class="col-md-6 mt-4">
                <label>
                    <input type="checkbox" id="IsRemote" />
                    Remote Job
                </label>
            </div>

            <div class="col-md-12 mt-3">
                <button type="button"
                        id="btnSave"
                        class="btn btn-success"
                        onclick="SaveJob();">
                    Post Job
                </button>
            </div>

        </div>

    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    $(document).ready(function () {
        const params = new URLSearchParams(window.location.search);
        const jobId = parseInt(params.get("jobId") || "0", 10);

        if (jobId > 0) {
            // EDIT MODE
            $("#JobId").val(jobId);
            $("#pageTitle").text("Edit Job");
            $("#submitButton, #btnSave").text("Update Job");

            GetJobDetails(jobId);
        } else {
            // ADD MODE
            $("#JobId").val(0);
            $("#pageTitle").text("Post New Job");
            $("#submitButton, #btnSave").text("Post Job");
        }

        // If the form uses a submit event, prevent a full-page refresh.
        $("#jobForm").on("submit", function (e) {
            e.preventDefault();
            SaveJob();
        });

        // Also supports a button using onclick="SaveJob()".
    });

  
    function GetJobDetails(jobId) {
        const businessId = parseInt($("#BusinessId").val(), 10) || 0;

        if (jobId <= 0 || businessId <= 0) {
            Swal.fire(
                "Error",
                "Valid Job ID and Business ID are required.",
                "error"
            );
            return;
        }

        $("#submitButton, #btnSave").prop("disabled", true);

        $.ajax({
            url: "/api/Job/GetBusinessJobPostById",
            type: "GET",
            data: {
                jobId: jobId,
                businessId: businessId
            },
            dataType: "json",

            success: function (response) {
                console.log("Job API response:", response);

                // Accept the API's actual response format.
                const resultId = response?.resultId ?? response?.ResultId;
                const job = response?.data ?? response?.Data;

                if (Number(resultId) !== 1 || !job) {
                    Swal.fire(
                        "Error",
                        response?.resultMessage ||
                        response?.ResultMessage ||
                        "Unable to load job details.",
                        "error"
                    );
                    return;
                }

                $("#JobId").val(job.jobId ?? job.JobId ?? jobId);
                $("#JobTitle").val(job.jobTitle ?? job.JobTitle ?? "");
                $("#Description").val(job.description ?? job.Description ?? "");
                $("#JobType").val(job.jobType ?? job.JobType ?? "");
                $("#Experience").val(job.experience ?? job.Experience ?? "");

                $("#SalaryMin").val(job.salaryMin ?? job.SalaryMin ?? "");
                $("#SalaryMax").val(job.salaryMax ?? job.SalaryMax ?? "");

                $("#Location").val(job.location ?? job.Location ?? "");
                $("#Skills").val(job.skills ?? job.Skills ?? "");

                $("#ContactEmail").val(
                    job.contactEmail ?? job.ContactEmail ?? ""
                );

                $("#ContactPhone").val(
                    job.contactPhone ?? job.ContactPhone ?? ""
                );

                const isRemote = job.isRemote ?? job.IsRemote ?? false;
                $("#IsRemote").prop(
                    "checked",
                    isRemote === true || isRemote === 1
                );

                const lastDate = job.lastDateToApply ?? job.LastDateToApply;

                $("#LastDateToApply").val(
                    lastDate ? String(lastDate).substring(0, 10) : ""
                );

                $("#pageTitle").text("Edit Job");
                $("#submitButton, #btnSave").text("Update Job");
            },

            error: function (xhr) {
                console.error(
                    "GetJobDetails failed:",
                    xhr.status,
                    xhr.responseText
                );

                const message =
                    xhr.responseJSON?.resultMessage ||
                    xhr.responseJSON?.ResultMessage ||
                    "Failed to retrieve job details.";

                Swal.fire("Error", message, "error");
            },

            complete: function () {
                $("#submitButton, #btnSave").prop("disabled", false);
            }
        });
    }

    // ================================
    // ADD OR UPDATE JOB
    // ================================
    function SaveJob() {
        const jobId = parseInt($("#JobId").val(), 10) || 0;

        const businessId = parseInt($("#BusinessId").val(), 10) || 0;
        const groupId = parseInt($("#GroupId").val(), 10) || 0;

        const model = {
            jobId: jobId,
            businessId: businessId,
            groupId: groupId,
            postedBy: $("#PostedBy").val() || "",
            companyName: "",

            jobTitle: $("#JobTitle").val()?.trim() || "",
            description: $("#Description").val()?.trim() || "",
            jobType: $("#JobType").val() || "",
            experience: $("#Experience").val()?.trim() || "",

            salaryMin: parseFloat($("#SalaryMin").val()) || 0,
            salaryMax: parseFloat($("#SalaryMax").val()) || 0,

            location: $("#Location").val()?.trim() || "",
            isRemote: $("#IsRemote").is(":checked"),
            skills: $("#Skills").val()?.trim() || "",
            contactEmail: $("#ContactEmail").val()?.trim() || "",
            contactPhone: $("#ContactPhone").val()?.trim() || "",
            lastDateToApply: $("#LastDateToApply").val() || null
        };

        // Basic client-side validation
        if (!model.jobTitle) {
            ShowMessage("warning", "Validation", "Please enter a job title.");
            return;
        }

        if (!model.description) {
            ShowMessage("warning", "Validation", "Please enter a job description.");
            return;
        }

        if (model.salaryMax > 0 && model.salaryMin > model.salaryMax) {
            ShowMessage(
                "warning",
                "Validation",
                "Minimum salary cannot be greater than maximum salary."
            );
            return;
        }

        console.log("Submitting job:", model);

        const $saveButton = $("#submitButton, #btnSave");
        $saveButton.prop("disabled", true);

        $.ajax({
            url: "/api/Job/BusinessPostJob",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify(model),

            success: function (response) {
                console.log("Save job response:", response);

                const resultId = response?.resultId ?? response?.ResultId;
                const resultMessage =
                    response?.resultMessage ??
                    response?.ResultMessage ??
                    (jobId > 0
                        ? "Job updated successfully."
                        : "Job posted successfully.");

                if (resultId !== 1) {
                    ShowMessage("error", "Unable to save job", resultMessage);
                    return;
                }

                ShowMessage("success", "Success", resultMessage)
                    .then(function () {
                        window.location.href = "/Business/Home/BusinessJobList";
                    });
            },

            error: function (xhr) {
                console.error(
                    "SaveJob error:",
                    xhr.status,
                    xhr.responseText
                );

                let message = "An error occurred while saving the job.";

                if (xhr.responseJSON?.resultMessage) {
                    message = xhr.responseJSON.resultMessage;
                } else if (xhr.responseJSON?.ResultMessage) {
                    message = xhr.responseJSON.ResultMessage;
                } else if (xhr.responseText) {
                    try {
                        const parsed = JSON.parse(xhr.responseText);
                        message =
                            parsed.resultMessage ||
                            parsed.ResultMessage ||
                            message;
                    } catch (e) {
                        // Keep the default message for non-JSON responses.
                    }
                }

                ShowMessage("error", "Save failed", message);
            },

            complete: function () {
                $saveButton.prop("disabled", false);
            }
        });
    }

    function ClearForm() {
        $("#JobId").val(0);

        $("#JobTitle").val("");
        $("#Description").val("");
        $("#JobType").val("");
        $("#Experience").val("");

        $("#SalaryMin").val("");
        $("#SalaryMax").val("");

        $("#Location").val("");
        $("#Skills").val("");
        $("#ContactEmail").val("");
        $("#ContactPhone").val("");
        $("#LastDateToApply").val("");

        $("#IsRemote").prop("checked", false);

        $("#submitButton, #btnSave").text("Post Job");
        $("#pageTitle").text("Post New Job");
    }

  
    function ShowMessage(icon, title, text) {
        if (typeof Swal !== "undefined") {
            return Swal.fire({
                icon: icon,
                title: title,
                text: text
            });
        }

        alert(title + "\n" + text);
        return Promise.resolve();
    }
</script>