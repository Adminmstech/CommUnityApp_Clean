@{
    ViewData["Title"] = "Business Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Business Login | IndoCommunity</title>
    <style>
        :root {
            --blue: #315efb;
            --ink: #17233b;
            --muted: #718096;
            --line: #e7ecf4
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
            color: var(--ink);
            background: #f4f7fc
        }

        .shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr .95fr
        }

        .visual {
            position: relative;
            overflow: hidden;
            background: radial-gradient(circle at 15% 15%,#315efb 0,transparent 35%),linear-gradient(145deg,#0c1a35,#173d70 62%,#087e89);
            color: #fff;
            padding: 52px clamp(28px,6vw,88px);
            display: flex;
            flex-direction: column;
            justify-content: space-between
        }

        .brand {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 850;
            letter-spacing: -.03em;
            font-size: 18px
        }

        .mark {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg,#fff,#b8fff1);
            color: #123b65;
            font-weight: 900;
            box-shadow: 0 8px 25px #06152c55
        }

        .hero {
            position: relative;
            z-index: 1;
            max-width: 560px;
            margin: 60px 0
        }

        .eyebrow {
            display: inline-flex;
            padding: 8px 12px;
            border: 1px solid #ffffff30;
            border-radius: 999px;
            background: #ffffff12;
            color: #d9fff9;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase
        }

        .hero h1 {
            font-size: clamp(36px,4.3vw,62px);
            line-height: 1.06;
            letter-spacing: -.055em;
            margin: 24px 0 18px
        }

        .hero p {
            font-size: 17px;
            line-height: 1.8;
            color: #d6e3f6;
            max-width: 450px
        }

        .features {
            display: grid;
            gap: 14px;
            margin-top: 32px
        }

        .feature {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #eef5ff;
            font-size: 14px
        }

            .feature span {
                width: 32px;
                height: 32px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                background: #ffffff18;
                border: 1px solid #ffffff1c
            }

        .foot {
            position: relative;
            z-index: 1;
            color: #b9cbe5;
            font-size: 12px
        }

        .form-side {
            display: grid;
            place-items: center;
            padding: 32px 22px
        }

        .card {
            width: min(430px,100%);
            background: #fff;
            border: 1px solid #e8edf5;
            border-radius: 24px;
            padding: clamp(26px,4vw,42px);
            box-shadow: 0 25px 70px #1b35600d
        }

        .kicker {
            color: var(--blue);
            font-weight: 850;
            font-size: 12px;
            letter-spacing: .12em;
            text-transform: uppercase
        }

        h2 {
            font-size: 31px;
            letter-spacing: -.04em;
            margin: 10px 0 8px
        }

        .sub {
            margin: 0 0 28px;
            color: var(--muted);
            line-height: 1.65;
            font-size: 14px
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 750;
            margin: 17px 0 8px
        }

        input {
            width: 100%;
            height: 49px;
            padding: 0 14px;
            border: 1px solid #dce4f0;
            border-radius: 11px;
            background: #fbfcff;
            font-size: 14px;
            outline: none
        }

            input:focus {
                border-color: #6484ff;
                box-shadow: 0 0 0 4px #315efb16;
                background: #fff
            }

        .submit {
            width: 100%;
            height: 50px;
            margin-top: 24px;
            border: 0;
            border-radius: 11px;
            color: #fff;
            background: linear-gradient(100deg,#315efb,#2547d9);
            font-weight: 850;
            font-size: 14px;
            cursor: pointer;
            box-shadow: 0 10px 22px #315efb2b
        }

            .submit:disabled {
                opacity: .65;
                cursor: wait
            }

        #message {
            display: none;
            margin-top: 16px;
            padding: 11px 13px;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.5
        }

            #message.error {
                display: block;
                background: #fff1f0;
                color: #b42318;
                border: 1px solid #ffd6d2
            }

            #message.success {
                display: block;
                background: #edfbf4;
                color: #147a4a;
                border: 1px solid #c7f1db
            }

        .security {
            text-align: center;
            color: #8290a5;
            font-size: 12px;
            margin-top: 22px
        }

        .mobile-brand {
            display: none
        }

        @@media(max-width:850px) {
            .shell {
                grid-template-columns: 1fr
            }

            .visual {
                display: none
            }

            .mobile-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 30px;
                font-weight: 850
            }

            .form-side {
                min-height: 100vh;
                background: radial-gradient(circle at top right,#e1e9ff,transparent 38%),#f4f7fc
            }
        }
    </style>
</head>
<body>
    <div class="shell">
        <aside class="visual">
            <div class="brand"><span class="mark">IC</span><span>IndoCommunity <span style="font-weight:500;color:#c4d7f3">Business</span></span></div>
            <div class="hero">
                <span class="eyebrow">✦ Business portal</span><h1>Better connections.<br />Smarter rewards.</h1>
                <p>Manage promotions, verify customer redemptions and deliver a seamless experience to your community.</p>
                <div class="features"><div class="feature"><span>◇</span> Manage promotions in one place</div><div class="feature"><span>▦</span> Scan QR codes at redemption</div><div class="feature"><span>✓</span> Track customer redemption history</div></div>
            </div>
            <div class="foot">© @DateTime.Now.Year IndoCommunity. Business access portal.</div>
        </aside>
        <main class="form-side">
            <div class="card">
                <div class="mobile-brand"><span class="mark">IC</span> IndoCommunity Business</div>
                <div class="kicker">Welcome back</div><h2>Sign in to your account</h2><p class="sub">Access your business workspace and manage customer offers.</p>
                <form id="loginForm">
                    <label for="email">Business email</label><input id="email" type="email" placeholder="you@business.com" autocomplete="username" required />
                    <label for="password">Password</label><input id="password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                    <button class="submit" id="loginButton" type="submit">Sign in to dashboard →</button>
                </form>
                <div id="message" role="alert" aria-live="polite"></div><div class="security">▣ &nbsp; Secure business sign-in</div>
            </div>
        </main>
    </div>
    <script>
        document.getElementById("loginForm").addEventListener("submit", async function (e) {
            e.preventDefault(); const message = document.getElementById("message"), button = document.getElementById("loginButton");
            message.className = ""; message.textContent = ""; button.disabled = true; button.textContent = "Signing in…";
            try {
                const response = await fetch("/api/Business/BusinessLogin", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: document.getElementById("email").value.trim(), password: document.getElementById("password").value }) });
                const result = await response.json();
                if (!response.ok || result.status === false || result.Status === false) { message.className = "error"; message.textContent = result.resultMessage || result.ResultMessage || "Login failed. Please check your credentials."; return; }
                message.className = "success"; message.textContent = "Signed in successfully. Opening your dashboard…";
                window.location.href = "/Business/BusinessWebApp/Dashboard";
            } catch (error) { message.className = "error"; message.textContent = "Unable to connect to the server. Please try again."; }
            finally { button.disabled = false; button.textContent = "Sign in to dashboard →"; }
        });
    </script>
</body>
</html>
