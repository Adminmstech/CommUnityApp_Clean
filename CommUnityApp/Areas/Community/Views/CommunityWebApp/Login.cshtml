@{
    ViewData["Title"] = "Community Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Community Login | IndoCommunity</title>

    <style>
        :root {
            --blue: #315efb;
            --ink: #17233b;
            --muted: #718096;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
            color: var(--ink);
            background: #f4f7fc;
        }

        .shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr .95fr;
        }

        .visual {
            background: radial-gradient(circle at 15% 15%,#315efb 0,transparent 35%), linear-gradient(145deg,#0c1a35,#173d70 62%,#087e89);
            color: white;
            padding: 52px clamp(28px,6vw,88px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 850;
            font-size: 18px;
        }

        .mark {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg,#fff,#b8fff1);
            color: #123b65;
            font-weight: 900;
        }

        .hero {
            max-width: 560px;
            margin: 60px 0;
        }

        .eyebrow {
            display: inline-flex;
            padding: 8px 12px;
            border: 1px solid #ffffff30;
            border-radius: 999px;
            background: #ffffff12;
            color: #d9fff9;
            font-size: 12px;
            font-weight: 800;
        }

        .hero h1 {
            font-size: clamp(36px,4.3vw,62px);
            line-height: 1.06;
            margin: 24px 0 18px;
        }

        .hero p {
            font-size: 17px;
            line-height: 1.8;
            color: #d6e3f6;
        }

        .features {
            display: grid;
            gap: 14px;
            margin-top: 32px;
        }

        .feature {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #eef5ff;
            font-size: 14px;
        }

            .feature span {
                width: 32px;
                height: 32px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                background: #ffffff18;
            }

        .foot {
            color: #b9cbe5;
            font-size: 12px;
        }

        .form-side {
            display: grid;
            place-items: center;
            padding: 32px 22px;
        }

        .card {
            width: min(430px,100%);
            background: white;
            border: 1px solid #e8edf5;
            border-radius: 24px;
            padding: clamp(26px,4vw,42px);
            box-shadow: 0 25px 70px #1b35600d;
        }

        .kicker {
            color: var(--blue);
            font-weight: 850;
            font-size: 12px;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        h2 {
            font-size: 31px;
            margin: 10px 0 8px;
        }

        .sub {
            margin: 0 0 28px;
            color: var(--muted);
            line-height: 1.65;
            font-size: 14px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 750;
            margin: 17px 0 8px;
        }

        input {
            width: 100%;
            height: 49px;
            padding: 0 14px;
            border: 1px solid #dce4f0;
            border-radius: 11px;
            background: #fbfcff;
            font-size: 14px;
            outline: none;
        }

            input:focus {
                border-color: #6484ff;
                box-shadow: 0 0 0 4px #315efb16;
                background: white;
            }

        .submit {
            width: 100%;
            height: 50px;
            margin-top: 24px;
            border: 0;
            border-radius: 11px;
            color: white;
            background: linear-gradient(100deg,#315efb,#2547d9);
            font-weight: 850;
            font-size: 14px;
            cursor: pointer;
        }

            .submit:disabled {
                opacity: .65;
                cursor: wait;
            }

        #message {
            display: none;
            margin-top: 16px;
            padding: 11px 13px;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.5;
        }

            #message.error {
                display: block;
                background: #fff1f0;
                color: #b42318;
                border: 1px solid #ffd6d2;
            }

            #message.success {
                display: block;
                background: #edfbf4;
                color: #147a4a;
                border: 1px solid #c7f1db;
            }

        .security {
            text-align: center;
            color: #8290a5;
            font-size: 12px;
            margin-top: 22px;
        }

        .mobile-brand {
            display: none;
        }

        @@media(max-width:850px) {
            .shell {
                grid-template-columns: 1fr;
            }

            .visual {
                display: none;
            }

            .mobile-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 30px;
                font-weight: 850;
            }

            .form-side {
                min-height: 100vh;
                background: radial-gradient(circle at top right,#e1e9ff,transparent 38%),#f4f7fc;
            }
        }
    </style>
</head>

<body>
    <div class="shell">

        <aside class="visual">
            <div class="brand">
                <span class="mark">IC</span>
                <span>IndoCommunity <span style="font-weight:500;color:#c4d7f3">Community</span></span>
            </div>

            <div class="hero">
                <span class="eyebrow">✦ Community portal</span>
                <h1>Stronger communities.<br />Better connections.</h1>
                <p>
                    Manage your community events, bookings, tickets and
                    member activities from one place.
                </p>

                <div class="features">
                    <div class="feature"><span>◇</span> Manage community events</div>
                    <div class="feature"><span>▦</span> View event bookings and tickets</div>
                    <div class="feature"><span>✓</span> Scan and track event attendance</div>
                </div>
            </div>

            <div class="foot">
                © @DateTime.Now.Year IndoCommunity. Community access portal.
            </div>
        </aside>

        <main class="form-side">
            <div class="card">

                <div class="mobile-brand">
                    <span class="mark">IC</span>
                    IndoCommunity Community
                </div>

                <div class="kicker">Welcome back</div>
                <h2>Sign in to your account</h2>
                <p class="sub">
                    Access your community workspace and manage your events.
                </p>

                <form id="loginForm">
                    <label for="userName">Username</label>
                    <input id="userName" type="text"
                           placeholder="Enter your username"
                           autocomplete="username" required />

                    <label for="password">Password</label>
                    <input id="password" type="password"
                           placeholder="Enter your password"
                           autocomplete="current-password" required />

                    <button class="submit" id="loginButton" type="submit">
                        Sign in to dashboard →
                    </button>
                </form>

                <div id="message" role="alert" aria-live="polite"></div>

                <div class="security">
                    ▣ &nbsp; Secure community sign-in
                </div>
            </div>
        </main>
    </div>


    <script>
        document.getElementById("loginForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const message = document.getElementById("message");
            const button = document.getElementById("loginButton");

            message.className = "";
            message.textContent = "";

            button.disabled = true;
            button.textContent = "Signing in…";

            try {
                const response = await fetch("/api/Community/AdminAppLogin", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        userName: document.getElementById("userName").value.trim(),
                        password: document.getElementById("password").value
                    })
                });

                // Safely read the API response
                const result = await response.json();

                if (!response.ok ||
                    result.status === false ||
                    result.Status === false ||
                    result.resultId === 0 ||
                    result.ResultId === 0) {

                    message.className = "error";
                    message.textContent =
                        result.resultMessage ||
                        result.ResultMessage ||
                        "Login failed. Please check your credentials.";

                    return;
                }

                const loginType = result.loginType || result.LoginType;

                if (!loginType ||
                    loginType.toLowerCase() !== "community") {

                    message.className = "error";
                    message.textContent =
                        "This login is not registered as a Community Admin.";

                    return;
                }

                const community = result.data || result.Data || {};

                const communityId =
                    community.communityId ??
                    community.CommunityId;

                if (!communityId || Number(communityId) <= 0) {
                    message.className = "error";
                    message.textContent =
                        "Community ID is missing from the login response.";

                    return;
                }

                message.className = "success";
                message.textContent =
                    "Login successful. Opening Community Dashboard...";

                // Session is already set by the API.
                window.location.replace(
                    "/Community/CommunityWebApp/Dashboard"
                );

            } catch (error) {
                console.error("Community Login Error:", error);

                message.className = "error";
                message.textContent =
                    "Unable to connect to the server. Please try again.";
            } finally {
                button.disabled = false;
                button.textContent = "Sign in to dashboard →";
            }
        });
    </script>

</body>
</html>
