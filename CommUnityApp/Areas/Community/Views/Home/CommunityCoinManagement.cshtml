    <!-- Wallet Transactions -->
    <div class="card mb-4">

        <div class="card-header bg-primary text-white">
            Wallet Transactions
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Coins</th>
                            <th>Reference Type</th>
                            <th>Reference Id</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody id="walletTransactionsBody">

                        <tr>
                            <td colspan="6"
                                class="text-center p-4">
                                Loading transactions...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- Share Reward History -->
    <div class="card mb-5">

        <div class="card-header bg-primary text-white">
            Share Reward History
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Promotion</th>
                            <th>Product</th>
                            <th>Platform</th>
                            <th>Reward Coins</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody id="rewardHistoryBody">

                        <tr>
                            <td colspan="6"
                                class="text-center p-4">
                                Loading reward history...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // =========================================================
        // COMMUNITY ID
        // =========================================================

        const communityId = '@ViewBag.CommunityId';

        console.log("Community ID:", communityId);


        // =========================================================
        // PAGE LOAD
        // =========================================================

        document.addEventListener("DOMContentLoaded", function () {

            console.log("Community Coin Management page loaded.");

            if (!communityId || communityId === "0") {
                console.error("CommunityId is missing.");
                return;
            }

            loadWallet();
            loadDashboard();
            loadTransactions();
            loadRewardHistory();

        });


        // =========================================================
        // NUMBER FORMAT
        // =========================================================

        function numberText(value) {

            if (value === null || value === undefined || value === "") {
                return "0";
            }

            return Number(value).toLocaleString();

        }


        // =========================================================
        // GET API DATA
        // =========================================================

        async function getApi(url) {

            console.log("Calling API:", url);

            const response = await fetch(url, {
                method: "GET",
                headers: {
                    "Content-Type": "application/json"
                }
            });

            console.log("API Status:", response.status);

            if (!response.ok) {
                throw new Error(
                    "API request failed. Status: " + response.status
                );
            }

            const data = await response.json();

            console.log("API Response:", data);

            return data;

        }


        // =========================================================
        // LOAD COMMUNITY WALLET
        // =========================================================

        async function loadWallet() {

            try {

                const url =
                    '/api/Community/GetCommunityWallet?communityId=' +
                    encodeURIComponent(communityId);

                const response = await getApi(url);

                console.log("Wallet Response:", response);


                // Handle different API response structures
                const wallet =
                    response?.data ??
                    response?.Data ??
                    response?.result ??
                    response?.Result ??
                    response;


                console.log("Wallet Object:", wallet);


                const availableCoins =
                    wallet?.availableCoins ??
                    wallet?.AvailableCoins ??
                    0;


                document.getElementById("availableCoins").innerText =
                    numberText(availableCoins);


            }
            catch (error) {

                console.error(
                    "Error loading community wallet:",
                    error
                );

                document.getElementById("availableCoins").innerText = "0";

            }

        }


        // =========================================================
        // LOAD COMMUNITY DASHBOARD
        // =========================================================

        async function loadDashboard() {

            try {

                const url =
                    '/api/Community/GetCommunityRewardsDashboard?communityId=' +
                    encodeURIComponent(communityId);

                const response = await getApi(url);

                console.log("FULL DASHBOARD RESPONSE:", response);


                // Handle all possible API response structures
                let dashboard = response;

                // { data: {...} }
                if (response?.data) {
                    dashboard = response.data;
                }

                // { Data: {...} }
                else if (response?.Data) {
                    dashboard = response.Data;
                }

                // { result: {...} }
                else if (response?.result) {
                    dashboard = response.result;
                }

                // { Result: {...} }
                else if (response?.Result) {
                    dashboard = response.Result;
                }


                // If API returns [{...}]
                if (Array.isArray(dashboard)) {
                    dashboard = dashboard.length > 0
                        ? dashboard[0]
                        : {};
                }


                console.log("DASHBOARD DATA:", dashboard);


                // =====================================================
                // GET VALUES
                // =====================================================

                const allocatedCoins =
                    dashboard?.totalAllocatedCoins ??
                    dashboard?.TotalAllocatedCoins ??
                    0;


                const spentCoins =
                    dashboard?.totalRewardCoinsSpent ??
                    dashboard?.TotalRewardCoinsSpent ??
                    0;


                const usersRewarded =
                    dashboard?.totalUsersRewarded ??
                    dashboard?.TotalUsersRewarded ??
                    0;


                console.log(
                    "Allocated Coins:",
                    allocatedCoins
                );

                console.log(
                    "Spent Coins:",
                    spentCoins
                );

                console.log(
                    "Users Rewarded:",
                    usersRewarded
                );


                // =====================================================
                // DISPLAY
                // =====================================================

                document.getElementById("allocatedCoins").innerText =
                    numberText(allocatedCoins);


                document.getElementById("spentCoins").innerText =
                    numberText(spentCoins);


                document.getElementById("usersRewarded").innerText =
                    numberText(usersRewarded);

            }
            catch (error) {

                console.error(
                    "Error loading community dashboard:",
                    error
                );


                document.getElementById("allocatedCoins").innerText = "0";

                document.getElementById("spentCoins").innerText = "0";

                document.getElementById("usersRewarded").innerText = "0";

            }

        }


        // =========================================================
        // LOAD WALLET TRANSACTIONS
        // =========================================================

        async function loadTransactions() {

            try {

                const url =
                    '/api/Community/GetCommunityWalletTransactions?communityId=' +
                    encodeURIComponent(communityId);


                const response = await getApi(url);

                console.log(
                    "Transactions Response:",
                    response
                );


                let data =
                    response?.data ??
                    response?.Data ??
                    response?.result ??
                    response?.Result ??
                    response;


                /*
                    If API returns:
                    {
                        data: [...]
                    }

                    OR

                    {
                        result: [...]
                    }

                    OR directly:
                    [...]
                */

                if (!Array.isArray(data)) {
                    data = [];
                }


                const tbody =
                    document.getElementById(
                        "walletTransactionsBody"
                    );


                if (data.length === 0) {

                    tbody.innerHTML = `
                            <tr>
                                <td colspan="6"
                                    class="text-center p-4">
                                    No transactions found.
                                </td>
                            </tr>
                        `;

                    return;
                }


                let rows = "";


                data.forEach(function (item) {

                    const createdAt =
                        item?.createdAt ??
                        item?.CreatedAt ??
                        null;


                    const transactionType =
                        item?.transactionType ??
                        item?.TransactionType ??
                        "-";


                    const coins =
                        item?.coins ??
                        item?.Coins ??
                        0;


                    const referenceType =
                        item?.referenceType ??
                        item?.ReferenceType ??
                        "-";


                    const referenceId =
                        item?.referenceId ??
                        item?.ReferenceId ??
                        "-";


                    const notes =
                        item?.notes ??
                        item?.Notes ??
                        "-";


                    rows += `
                            <tr>

                                <td>
                                    ${formatDate(createdAt)}
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        ${escapeHtml(transactionType)}
                                    </span>
                                </td>

                                <td class="cell-money">
                                    ${numberText(coins)}
                                </td>

                                <td>
                                    ${escapeHtml(referenceType)}
                                </td>

                                <td>
                                    ${referenceId}
                                </td>

                                <td class="text-wrap">
                                    ${escapeHtml(notes)}
                                </td>

                            </tr>
                        `;

                });


                tbody.innerHTML = rows;
                 
            }
            catch (error) {

                console.error(
                    "Error loading wallet transactions:",
                    error
                );


                document.getElementById(
                    "walletTransactionsBody"
                ).innerHTML = `
                        <tr>
                            <td colspan="6"
                                class="text-center text-danger p-4">
                                Failed to load transactions.
                            </td>
                        </tr>
                    `;

            }

        }


        // =========================================================
        // LOAD SHARE REWARD HISTORY
        // =========================================================

        async function loadRewardHistory() {

            try {

                const url =
                    '/api/Community/GetCommunityShareRewardHistory?communityId=' +
                    encodeURIComponent(communityId);


                const response = await getApi(url);

                console.log(
                    "Reward History Response:",
                    response
                );


                let data =
                    response?.data ??
                    response?.Data ??
                    response?.result ??
                    response?.Result ??
                    response;


                if (!Array.isArray(data)) {
                    data = [];
                }


                const tbody =
                    document.getElementById(
                        "rewardHistoryBody"
                    );


                if (data.length === 0) {

                    tbody.innerHTML = `
                            <tr>
                                <td colspan="6"
                                    class="text-center p-4">
                                    No reward history found.
                                </td>
                            </tr>
                        `;

                    return;
                }


                let rows = "";


                data.forEach(function (item) {

                    const userName =
                        item?.userName ??
                        item?.UserName ??
                        "-";


                    const promotionName =
                        item?.promotionName ??
                        item?.PromotionName ??
                        "-";


                    const productName =
                        item?.productName ??
                        item?.ProductName ??
                        "-";


                    const sharePlatform =
                        item?.sharePlatform ??
                        item?.SharePlatform ??
                        "-";


                    const rewardCoins =
                        item?.rewardCoins ??
                        item?.RewardCoins ??
                        0;


                    const sharedAt =
                        item?.sharedAt ??
                        item?.SharedAt ??
                        null;


                    rows += `
                            <tr>

                                <td class="cell-strong">
                                    ${escapeHtml(userName)}
                                </td>

                                <td>
                                    ${escapeHtml(promotionName)}
                                </td>

                                <td>
                                    ${escapeHtml(productName)}
                                </td>

                                <td>
                                    ${escapeHtml(sharePlatform)}
                                </td>

                                <td class="cell-money">
                                    ${numberText(rewardCoins)}
                                </td>

                                <td>
                                    ${formatDate(sharedAt)}
                                </td>

                            </tr>
                        `;

                });


                tbody.innerHTML = rows;

            }
            catch (error) {

                console.error(
                    "Error loading reward history:",
                    error
                );


                document.getElementById(
                    "rewardHistoryBody"
                ).innerHTML = `
                        <tr>
                            <td colspan="6"
                                class="text-center text-danger p-4">
                                Failed to load reward history.
                            </td>
                        </tr>
                    `;

            }

        }


        // =========================================================
        // DATE FORMAT
        // =========================================================

        function formatDate(value) {

            if (!value) {
                return "-";
            }

            try {

                const date = new Date(value);

                if (isNaN(date.getTime())) {
                    return value;
                }

                return date.toLocaleString();

            }
            catch {

                return value;

            }

        }


        // =========================================================
        // HTML ESCAPE
        // =========================================================

        function escapeHtml(value) {

            if (value === null || value === undefined) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }

    </script>

}