@{
    ViewData["Title"] = "Event Sponsors";
    Layout = "~/Areas/Community/Views/Shared/_CommunityLayout.cshtml";
}

<input type="hidden" id="CommunityId" value="@Context.Session.GetString("CommunityId")" />

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <h5>Event Sponsors</h5>

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle" id="tblSponsors">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Logo</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Amount</th>
                        <th>Type</th>
                        <th>Other Info</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="9" class="text-center">Loading...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        loadSponsors();
    });

    function loadSponsors() {
        var communityId = $("#CommunityId").val();

        $.ajax({
            url: '/api/Event/GetSponsorsByCommunity?communityId=' + encodeURIComponent(communityId),
            type: 'GET',
            success: function (res) {

                var html = "";

                if (!res || res.length === 0) {
                    html += "<tr><td colspan='9' class='text-center'>No records found</td></tr>";
                }
                else {
                    $.each(res, function (i, item) {
                        var logoPath = item.logoPath || "";

                        if (logoPath && !logoPath.startsWith("/") && !logoPath.startsWith("http")) {
                            logoPath = "/" + logoPath;
                        }

                        html += "<tr>";
                        html += "<td>" + (i + 1) + "</td>";
                        html += "<td>" + (logoPath ? "<img src='" + logoPath + "' alt='Sponsor logo' />" : "-") + "</td>";
                        html += "<td>" + item.sponsorName + "</td>";
                        html += "<td>" + item.mobile + "</td>";
                        html += "<td>" + item.email + "</td>";
                        html += "<td>₹ " + item.amount + "</td>";

                        if (item.sponsorType === "Gold")
                            html += "<td><span class='badge bg-warning'>Gold</span></td>";
                        else if (item.sponsorType === "Silver")
                            html += "<td><span class='badge bg-secondary'>Silver</span></td>";
                        else
                            html += "<td><span class='badge bg-dark'>Bronze</span></td>";

                        html += "<td>" + (item.otherInfo || "-") + "</td>";
                        html += "<td>" + new Date(item.createdDate).toLocaleDateString() + "</td>";
                        html += "</tr>";
                    });
                }

                $("#tblSponsors tbody").html(html);
            },
            error: function (err) {
                var message = err.responseText || "Unable to load sponsors";
                $("#tblSponsors tbody").html("<tr><td colspan='9' class='text-center text-danger'>" + message + "</td></tr>");
                console.log(message);
            }
        });
    }
</script>
