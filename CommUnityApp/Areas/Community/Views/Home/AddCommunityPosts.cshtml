@{
    ViewData["Title"] = "Add Community Post";
    Layout = "~/Areas/Community/Views/Shared/_CommunityLayout.cshtml";
}

<style>
    .community-posts-card .card-body {
        padding: 20px;
    }

    .community-posts-table-wrap {
        overflow-x: auto;
    }

    .community-posts-table-wrap > .community-posts-table {
        table-layout: fixed;
        width: 100%;
        min-width: 1180px;
    }

    .community-posts-table th,
    .community-posts-table td {
        border-color: #d8e0e3;
        vertical-align: middle;
    }

    .community-posts-table thead th {
        font-size: 13px;
        text-transform: none;
    }

    .community-posts-table .col-index {
        width: 34px;
        text-align: center;
    }

    .community-posts-table .col-image {
        width: 134px;
    }

    .community-posts-table .col-title {
        width: 190px;
    }

    .community-posts-table .col-message {
        width: auto;
    }

    .community-posts-table .col-date {
        width: 106px;
    }

    .community-posts-table .col-actions {
        width: 98px;
        text-align: center;
    }

    .post-image-cell,
    .post-action-cell {
        text-align: center;
    }

    .community-posts-table .post-title-cell,
    .community-posts-table .post-message-cell,
    .community-posts-table .post-date-cell {
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .community-posts-table .post-title-cell {
        font-size: 15px;
        line-height: 1.45;
    }

    .community-posts-table .post-message-cell {
        font-size: 15px;
        line-height: 1.52;
    }

    .community-posts-table .post-date-cell {
        font-size: 14px;
        line-height: 1.5;
    }

    .community-posts-table .community-post-image {
        width: 112px;
        height: 88px;
        max-width: 112px;
        object-fit: cover;
        border: 1px solid #d8e0e3;
        border-radius: 8px;
        background: #fff;
    }

    .post-no-image {
        color: #6b7280;
        font-size: 14px;
        white-space: nowrap;
    }

    .post-delete-btn {
        min-width: 74px;
        min-height: 64px;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-size: 13px;
        font-weight: 700;
        border-radius: 6px;
    }
</style>

<div class="container-fluid mt-4">

    <!-- CREATE POST -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h4 class="mb-4">

                <i class="fa-solid fa-pen-to-square"></i>

                Create Community Post

            </h4>

            <div class="row">

                <!-- TITLE -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Title
                    </label>

                    <input type="text"
                           id="title"
                           class="form-control"
                           placeholder="Enter title" />

                </div>

                <!-- IMAGE -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Upload Image
                    </label>

                    <input type="file"
                           id="imageFile"
                           class="form-control" />

                </div>

                <!-- BUTTON -->

                <div class="col-md-4 d-flex align-items-end">

                    <button class="btn btn-primary w-100"
                            onclick="savePost()">

                        <i class="fa-solid fa-paper-plane"></i>

                        Post Message

                    </button>

                </div>

            </div>

            <!-- MESSAGE -->

            <div class="mb-3">

                <label class="form-label">
                    Message
                </label>

                <textarea id="message"
                          class="form-control"
                          rows="4"
                          placeholder="Write message"></textarea>

            </div>

            <!-- PREVIEW -->

            <div class="text-center">

                <img id="previewImage"
                     style="
                        width:300px;
                        max-height:220px;
                        object-fit:cover;
                        border-radius:12px;
                        display:none;" />

            </div>

        </div>

    </div>

    <!-- POSTS GRID -->

    <div class="card shadow-sm border-0 community-posts-card">

        <div class="card-body">

            <h4 class="mb-4">

                <i class="fa-solid fa-list"></i>

                Community Posts

            </h4>

            <div class="table-responsive community-posts-table-wrap">

                <table class="table table-bordered
                              align-middle community-posts-table">

                    <colgroup>
                        <col class="col-index" />
                        <col class="col-image" />
                        <col class="col-title" />
                        <col class="col-message" />
                        <col class="col-date" />
                        <col class="col-actions" />
                    </colgroup>

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Image</th>

                            <th>Title</th>

                            <th>Message</th>

                            <th>Posted Date</th>

                            <th>Actions</th>

                        </tr>

                    </thead>

                    <tbody id="postsContainer">
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>


    $("#imageFile").change(function () {

        let file = this.files[0];

        if (file) {

            let reader = new FileReader();

            reader.onload = function (e) {

                $("#previewImage")
                    .attr("src", e.target.result)
                    .show();
            };

            reader.readAsDataURL(file);
        }
    });



    $(document).ready(function () {

        loadPosts();
    });

    

    function savePost() {

        let title =
            $("#title").val().trim();

        let message =
            $("#message").val().trim();


        if (title == "") {

            alert("Please enter title");

            return;
        }

        if (message == "") {

            alert("Please enter message");

            return;
        }

      

        let formData = new FormData();

        formData.append(
            "CommunityId",
            "@Context.Session.GetString("CommunityId")");

        formData.append(
            "Title",
            title);

        formData.append(
            "Message",
            message);

        formData.append(
            "CreatedBy",
            "@Context.Session.GetString("CommunityId")");

      

        let file =
            $("#imageFile")[0].files[0];

        if (file != null) {

            formData.append(
                "ImageFile",
                file);
        }


        $.ajax({

            url:
                "/api/Community/AddCommunityPost",

            type: "POST",

            data: formData,

            processData: false,

            contentType: false,

            success: function (res) {


                alert(
                    res.resultMessage ||
                    res.ResultMessage ||
                    "Post added successfully"
                );

               

                $("#title").val("");

                $("#message").val("");

                $("#imageFile").val("");

                $("#previewImage").hide();

          

                loadPosts();
            },

            error: function (xhr) {

                console.log(xhr);

                alert(
                    xhr.responseText ||
                    "Failed to add post"
                );
            }
        });
    }

 

    function loadPosts() {

        let communityId =
            "@Context.Session.GetString("CommunityId")";

        $.get(

            `/api/Community/GetCommunityPosts/${communityId}`,

            function (res) {

                let html = "";


                if (res.data.length == 0) {

                    html = `
                        <tr>

                            <td colspan="6"
                                class="text-center text-muted">

                                No posts found

                            </td>

                        </tr>`;
                }

           

                res.data.forEach((p, index) => {

                    html += `

                        <tr>

                            <td class="col-index">
                                ${index + 1}
                            </td>

                            <td class="post-image-cell">

                                ${p.imagePath
                            ?
                            `<img src="${p.imagePath}"
                                          class="community-post-image"
                                          alt="Post image">`
                            :
                            `<span class="post-no-image">
                                        No Image
                                     </span>`
                        }

                            </td>

                            <td class="post-title-cell">

                                <strong>

                                    ${p.title}

                                </strong>

                            </td>

                            <td class="post-message-cell">

                                ${p.message}

                            </td>

                            <td class="post-date-cell">

                                ${p.createdDateString}

                            </td>

                            <td class="post-action-cell">

                                <button class="btn btn-danger btn-sm post-delete-btn"
                                        onclick="deletePost(${p.postId})">

                                    <i class="fa-solid fa-trash"></i>

                                    Delete

                                </button>

                            </td>

                        </tr>`;
                });

                $("#postsContainer").html(html);
            });
    }


    function deletePost(postId) {

        if (!confirm(
            "Are you sure you want to delete this post?"
        )) {
            return;
        }

        $.ajax({

            url:
                `/api/Community/DeleteCommunityPost/${postId}`,

            type: "DELETE",

            success: function (res) {

                alert(
                    res.resultMessage ||
                    "Post deleted successfully"
                );

                loadPosts();
            },

            error: function () {

                alert("Failed to delete post");
            }
        });
    }

</script>
