<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Indian Community</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --sidebar-bg: #12393c;
            --sidebar-hover: #1b5052;
            --sidebar-link: #dcefed;
            --sidebar-link-active: #ffffff;
            --primary: #137c72;
            --primary-dark: #0d5f58;
            --accent: #d3a13d;
            --surface: #ffffff;
            --bg-light: #f6f8f8;
            --border: #d9e4e3;
            --text-main: #172625;
            --text-muted: #627271;
            --success: #15803d;
            --danger: #b91c1c;
            --warning: #b7791f;
            --info: #0e7490;
            --table-head: #176c64;
            --table-head-border: #2c8279;
        }

        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: var(--bg-light);
            color: var(--text-main);
        }

        .layout {
            display: flex;
            height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: var(--sidebar-bg);
            color: var(--sidebar-link);
            padding: 18px 16px;
            flex-shrink: 0;
            transition: all .3s ease;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            border-right: 1px solid #0d2c2f;
            box-shadow: 8px 0 24px rgba(18,57,60,.18);
        }

        .sidebar.collapsed {
            width: 0;
            padding: 0;
            overflow: hidden;
            border-right: 0;
        }

        .sidebar h3 {
            color: #ffffff;
            font-size: 18px;
            font-weight: 800;
            line-height: 1.25;
            margin: 0 0 18px;
            padding: 4px 8px 16px;
            border-bottom: 1px solid rgba(255,255,255,.14);
            word-break: break-word;
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding-top: 4px;
        }

        .menu-item {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 40px;
            padding: 10px 11px;
            border-radius: 8px;
            color: var(--sidebar-link);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.25;
            transition: background .18s ease, color .18s ease, transform .18s ease;
        }

        .nav a:hover,
        .nav a:focus {
            background: var(--sidebar-hover);
            color: var(--sidebar-link-active);
        }

        .nav a.active,
        .nav a[aria-current="page"] {
            background: #e7f6f3;
            color: #0b4d48;
            box-shadow: inset 4px 0 0 var(--accent);
        }

        .nav a:active {
            transform: translateY(1px);
        }

        .nav i {
            width: 20px;
            text-align: center;
            color: #8fd6cc;
            font-size: 17px;
            flex-shrink: 0;
        }

        .submenu {
            display: none;
            margin: 0 0 6px 22px;
            padding-left: 12px;
            border-left: 1px solid rgba(255,255,255,.16);
        }

        .submenu a {
            min-height: 34px;
            padding: 8px 10px;
            border-radius: 7px;
            color: #c7e3df;
            font-size: 13px;
            font-weight: 600;
        }

        .submenu a i {
            font-size: 14px;
            color: #91c9c1;
        }

        .main {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            background: var(--bg-light);
        }

        .topbar {
            height: 68px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 28px;
            flex-shrink: 0;
            box-shadow: 0 1px 2px rgba(20,35,31,.04);
        }

        .top-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .menu-btn {
            font-size: 20px;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .menu-btn:hover {
            background: #edf5f1;
            color: var(--primary);
        }

        .page-title {
            color: var(--text-main);
            font-size: 20px;
            font-weight: 800;
            line-height: 1.2;
        }

        .user-btn {
            background: #eef6f2;
            border: 1px solid #d6e7df;
            color: var(--primary-dark);
            font-weight: 700;
            cursor: pointer;
            min-height: 40px;
            padding: 8px 12px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .user-btn:hover {
            background: #e3f0ea;
        }

        .content {
            flex: 1;
            min-width: 0;
            overflow-y: auto;
            padding: 28px;
            background:
                linear-gradient(180deg, rgba(255,255,255,.75), rgba(243,247,245,.92)),
                var(--bg-light);
        }

        .content .container,
        .content .container-fluid {
            max-width: 100%;
            padding-left: 0;
            padding-right: 0;
        }

        .content h1,
        .content h2,
        .content h3,
        .content h4 {
            color: var(--text-main);
            font-weight: 800;
            letter-spacing: 0;
        }

        .card {
            border: 1px solid var(--border) !important;
            border-radius: 8px !important;
            box-shadow: 0 10px 28px rgba(20,35,31,.06) !important;
            overflow: hidden;
        }

        .card-header,
        .content .bg-primary {
            background: var(--table-head) !important;
            border-color: var(--table-head-border) !important;
            color: #fff !important;
        }

        .card-body {
            color: var(--text-main);
        }

        .btn,
        .form-control,
        .form-select {
            border-radius: 8px;
        }

        .btn {
            font-weight: 700;
        }

        .btn-primary,
        .btn-success {
            background-color: var(--primary) !important;
            border-color: var(--primary) !important;
            color: #fff !important;
        }

        .btn-primary:hover,
        .btn-primary:focus,
        .btn-success:hover,
        .btn-success:focus {
            background-color: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
        }

        .btn-secondary {
            background-color: #64756f !important;
            border-color: #64756f !important;
        }

        .btn-light {
            color: var(--primary-dark);
            border-color: #d6e7df;
        }

        label,
        .form-label {
            color: var(--text-main);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .form-control,
        .form-select {
            border-color: var(--border);
            color: var(--text-main);
            min-height: 42px;
        }

        textarea.form-control {
            min-height: 110px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 .2rem rgba(22,116,91,.16);
        }

        .table-responsive {
            border: 1px solid var(--border);
            border-radius: 8px;
            width: 100%;
            max-width: 100%;
            overflow-x: auto;
            background: var(--surface);
            -webkit-overflow-scrolling: touch;
        }

        .table {
            margin-bottom: 0;
            color: var(--text-main);
            vertical-align: middle;
        }

        .table-responsive > .table {
            min-width: max-content;
        }

        .table-bordered > :not(caption) > * {
            border-width: 0;
        }

        .table > :not(caption) > * > * {
            padding: 13px 15px;
            border-bottom-color: #e6eee9;
            vertical-align: middle;
        }

        .table thead,
        .table thead th,
        .table .table-dark th {
            background-color: var(--table-head) !important;
            border-color: var(--table-head-border) !important;
            color: #f8fafc !important;
        }

        .table thead th {
            font-size: 12px;
            font-weight: 800;
            line-height: 1.2;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .table tbody td {
            font-size: 14px;
            line-height: 1.35;
            white-space: nowrap;
        }

        .table td img {
            width: 56px;
            height: 56px;
            max-width: 56px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #fff;
            display: block;
        }

        .table tbody tr:hover > * {
            background-color: #f7fbf9;
        }

        .table td.text-wrap,
        .table .cell-wrap {
            min-width: 220px;
            white-space: normal;
        }

        .table td:last-child .btn,
        .table .btn-sm {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 32px;
            white-space: nowrap;
        }

        .badge {
            border-radius: 999px;
            font-weight: 800;
            padding: .42rem .62rem;
        }

        .badge.bg-primary,
        .badge.bg-success {
            background-color: #dcfce7 !important;
            color: #166534 !important;
        }

        .badge.bg-danger {
            background-color: #fee2e2 !important;
            color: #991b1b !important;
        }

        .badge.bg-warning {
            background-color: #fef3c7 !important;
            color: #92400e !important;
        }

        .badge.bg-info {
            background-color: #e0f2fe !important;
            color: #075985 !important;
        }

        .footer {
            height: 48px;
            background: var(--surface);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: var(--text-muted);
        }

        @@media (max-width: 768px) {

            .sidebar {
                position: fixed;
                top: 0;
                left: -260px;
                height: 100vh;
                z-index: 1100;
                box-shadow: 4px 0 30px rgba(0,0,0,.3);
            }

            .sidebar.open {
                left: 0;
            }

            .sidebar.collapsed {
                width: 260px;
                padding: 18px 16px;
            }

            .mobile-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15,23,42,.55);
                z-index: 1000;
                display: none;
            }

            .mobile-overlay.show {
                display: block;
            }

            .topbar {
                padding: 0 16px;
            }

            .content {
                padding: 18px;
            }

            .page-title {
                font-size: 17px;
            }

            .table > :not(caption) > * > * {
                padding: 11px 12px;
            }
        }
    </style>
</head>

<body>

    <!-- MOBILE OVERLAY -->
    <div class="mobile-overlay" id="overlay" onclick="closeSidebar()"></div>

    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <h3>🏛 @Context.Session.GetString("CommunityName")</h3>

            <nav class="nav">

                <a href="/Home" onclick="closeSidebar()">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>

                <!-- Events -->
                <div class="menu-item">
                    <a href="#" onclick="toggleMenu('eventsMenu')">
                        <i class="bi bi-calendar-event"></i>
                        Events
                    </a>

                    <div id="eventsMenu" class="submenu">

                        <a href="/Community/Home/AddEvent"
                           onclick="closeSidebar()">
                            <i class="bi bi-plus-circle"></i>
                            Add Event
                        </a>

                        <a href="/Community/Home/ViewEvents"
                           onclick="closeSidebar()">
                            <i class="bi bi-card-list"></i>
                            View Events
                        </a>
                        <a href="/Community/Home/AddEventTicketType">
                            <i class="bi bi-plus-circle"></i>
                            Add Event TicketType
                        </a>
                        <a href="/Community/Home/ViewEventTicketType">
                            <i class="bi bi-card-list"></i>
                           View Event TicketType
                        </a>

                    </div>
                </div>

                <!-- Sponsors -->
                <div class="menu-item">

                    <a href="#"
                       onclick="toggleMenu('sponsorMenu')">

                        <i class="bi bi-people-fill"></i>
                        Sponsors
                    </a>

                    <div id="sponsorMenu" class="submenu">

                        <a href="/Community/Home/AddEventSponsors">
                            <i class="bi bi-plus-circle"></i>
                            Add Sponsor
                        </a>
                       
                        <a href="/Community/Home/EventSponsors">
                            <i class="bi bi-card-list"></i>
                            View Sponsors
                        </a>

                        <a href="/Community/Home/AddSponsorsToEvent">
                            <i class="bi bi-link-45deg"></i>
                            Add Sponsors To Event
                        </a>

                    </div>
                </div>

                <!-- Charity -->
                <div class="menu-item">

                    <a href="#"
                       onclick="toggleMenu('charityMenu')">

                        <i class="bi bi-gift-fill"></i>
                        Helping Hands
                    </a>

                    <div id="charityMenu" class="submenu">

                        <a href="/Community/Home/CharityList">
                            <i class="bi bi-list-ul"></i>
                            Charity List
                        </a>

                        <a href="/Community/Home/ItemRequestList">
                            <i class="bi bi-journal-text"></i>
                            Item Requests
                        </a>

                        <a href="/Community/Home/DeliveryReport">
                            <i class="bi bi-truck"></i>
                            Delivery Report
                        </a>

                    </div>
                </div>

                <!-- Members -->
                <div class="menu-item">

                    <a href="#"
                       onclick="toggleMenu('memberMenu')">

                        <i class="bi bi-people"></i>
                        Members
                    </a>

                    <div id="memberMenu" class="submenu">

                        <a href="/Member/AddMember">
                            <i class="bi bi-person-plus"></i>
                            Add Member
                        </a>

                        <a href="/Community/Home/ViewMembers">
                            <i class="bi bi-card-list"></i>
                            View Members
                        </a>

                    </div>
                </div>

                <!-- Communication -->
                <div class="menu-item">

                    <a href="#"
                       onclick="toggleMenu('messagesMenu')">

                        <i class="bi bi-chat-dots"></i>
                        MessageBoard
                    </a>

                    <div id="messagesMenu" class="submenu">

                        <a href="/Community/Home/CommunityChat">
                            <i class="bi bi-send"></i>
                            Send Message
                        </a>

                        <a href="/Community/Home/ViewMessageBoardPosts">
                            <i class="bi bi-chat-square-text"></i>
                            MessageBoard Posts
                        </a>

                    </div>
                </div>
                <div class="menu-item">

                    <a href="#"
                       onclick="toggleMenu('careconnectMenu')">

                        <i class="bi bi-chat-dots"></i>
                        CareConnect 
                    </a>

                    <div id="careconnectMenu" class="submenu">

                        <a href="/Community/Home/CareConnectList">
                            <i class="bi bi-controller"></i>
                            CareConnect Requests
                        </a>

                    </div>
                </div>
                <div class="menu-item">

                    <a href="#"
                       onclick="toggleMenu('communicationMenu')">

                        <i class="bi bi-chat-dots"></i>
                        Community Posts
                    </a>

                    <div id="communicationMenu" class="submenu">

                        <a href="/Community/Home/CommunityPosts">
                            <i class="bi bi-controller"></i>
                            Community Posts
                        </a>

                        <a href="/Community/Home/AddCommunityPosts">
                            <i class="bi bi-send"></i>
                            Send Community Post
                        </a>

                    </div>
                </div>
                <!-- Reports -->
                <div class="menu-item">

                    <a href="#"
                       onclick="toggleMenu('gameMenu')">

                        <i class="bi bi-bar-chart"></i>
                        Reports
                    </a>

                    <div id="gameMenu" class="submenu">

                        <a href="/Community/Home/ViewSpinGameGameResults">
                            <i class="bi bi-controller"></i>
                            SpinGame Results
                        </a>

                        <a href="/Community/Home/ViewBrandGameResults">
                            <i class="bi bi-trophy"></i>
                            BrandGame Results
                        </a>

                    </div>
                </div>

                <!-- Settings -->

                <a href="/Settings">
                    <i class="bi bi-gear"></i>
                    Settings
                </a>

            </nav>
        </aside>

        <!-- MAIN -->
        <div class="main">

            <!-- TOPBAR -->
            <header class="topbar">
                <div class="top-left">
                    <button class="menu-btn" onclick="toggleSidebar()">☰</button>
                    <span class="page-title">@ViewData["Title"]</span>
                </div>

                <div class="dropdown">
                    <button class="user-btn"
                            data-bs-toggle="dropdown">

                        <i class="bi bi-person-circle"></i>
                        Admin
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item text-danger"
                               href="javascript:void(0)"
                               onclick="logout()">

                                <i class="bi bi-box-arrow-right"></i>
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </header>

            <!-- CONTENT -->
            <main class="content">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="footer">
                © 2026 Indian Community. All rights reserved.
            </footer>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("overlay");

        function toggleSidebar() {
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle("open");
                overlay.classList.toggle("show");
            } else {
                sidebar.classList.toggle("collapsed");
            }
        }

        function closeSidebar() {
            sidebar.classList.remove("open");
            overlay.classList.remove("show");
        }
        function toggleMenu(menuId) {
            var menu = document.getElementById(menuId);
            if (menu.style.display === "block")
                menu.style.display = "none";
            else
                menu.style.display = "block";
        }

        function logout() {

            localStorage.clear();
            sessionStorage.clear();

            window.location.replace("/Community/Account/Logout");
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
