@{
    var adminName = Context.Session.GetString("AdminName") ?? "Super Admin";
    var adminInitial = adminName.Substring(0, 1).ToUpper();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Super Admin Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <style>
        :root {
            --sidebar-bg: #111827;
            --sidebar-hover: #1f2937;
            --sidebar-active: #0f766e;
            --primary: #0f766e;
            --primary-dark: #115e59;
            --accent: #b45309;
            --success: #15803d;
            --danger: #b91c1c;
            --warning: #ca8a04;
            --text-main: #111827;
            --text-muted: #6b7280;
            --bg-light: #f3f4f6;
            --surface: #ffffff;
            --surface-soft: #f9fafb;
            --border: #d1d5db;
            --table-head: #1f2937;
            --table-head-border: #374151;
        }

        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: var(--bg-light);
            color: var(--text-main);
        }

        .layout {
            display: flex;
            height: 100vh;
        }

        .sidebar {
            width: 280px;
            background: var(--sidebar-bg);
            color: white;
            padding: 22px 16px;
            flex-shrink: 0;
            transition: all .3s ease;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            border-right: 1px solid rgba(255,255,255,.08);
        }

            .sidebar.collapsed {
                width: 0;
                padding: 0;
                overflow: hidden;
            }

        .brand {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 12px;
            color: #f9fafb;
        }

            .brand i {
                color: #2dd4bf;
                font-size: 24px;
            }

        .nav-section-title {
            color: #9ca3af;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            margin: 18px 12px 8px;
            text-transform: uppercase;
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .nav a {
                display: flex;
                align-items: center;
                gap: 12px;
                min-height: 44px;
                padding: 11px 13px;
                border-radius: 8px;
                color: #d1d5db;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                transition: all .2s ease;
            }

                .nav a:hover,
                .nav a.active {
                    background: var(--sidebar-hover);
                    color: white;
                }

                .nav a.active {
                    background: var(--sidebar-active);
                }

            .nav i {
                width: 20px;
                text-align: center;
                font-size: 17px;
            }

        .main {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            background: var(--bg-light);
        }

        .topbar {
            height: 68px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 28px;
            flex-shrink: 0;
            box-shadow: 0 1px 2px rgba(17,24,39,.04);
        }

        .top-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .menu-btn {
            font-size: 20px;
            background: none;
            border: none;
            cursor: pointer;
            color: #374151;
        }

        .page-title {
            font-weight: 700;
            font-size: 20px;
            color: var(--text-main);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .notification-btn {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #374151;
        }

        .content {
            flex: 1;
            min-width: 0;
            overflow-y: auto;
            padding: 28px;
        }

        .content .container-fluid {
            padding-left: 0;
            padding-right: 0;
        }

        .content .card {
            min-width: 0;
            border: 1px solid var(--border) !important;
            border-radius: 8px !important;
            box-shadow: 0 10px 30px rgba(17,24,39,.06) !important;
        }

        .content .card-body {
            min-width: 0;
        }

        .content .card-header {
            border-bottom: 1px solid var(--border);
            border-radius: 8px 8px 0 0 !important;
        }

        .content .card-header h4,
        .content .section-header h5 {
            font-size: 18px;
            font-weight: 700;
            line-height: 1.3;
        }

        .content .bg-primary,
        .modal-header.bg-primary,
        .btn-primary {
            background-color: var(--primary) !important;
            border-color: var(--primary) !important;
        }

        .btn-primary:hover,
        .btn-primary:focus {
            background-color: var(--primary-dark) !important;
            border-color: var(--primary-dark) !important;
        }

        .btn,
        .form-control,
        .form-select {
            border-radius: 8px;
        }

        .form-control,
        .form-select {
            border-color: var(--border);
            color: var(--text-main);
            min-height: 42px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 .2rem rgba(15,118,110,.15);
        }

        .table-responsive {
            border: 1px solid var(--border);
            border-radius: 8px;
            width: 100%;
            max-width: 100%;
            overflow-x: auto;
            overflow-y: auto;
            background: var(--surface);
            -webkit-overflow-scrolling: touch;
        }

        .table {
            margin-bottom: 0;
            color: var(--text-main);
            vertical-align: middle;
        }

        .table-responsive > .table {
            min-width: max-content;
        }

        .table > :not(caption) > * > * {
            padding: 13px 16px;
            border-bottom-color: #e5e7eb;
            vertical-align: middle;
        }

        .table thead th,
        .table .table-dark th {
            background-color: var(--table-head) !important;
            border-color: var(--table-head-border) !important;
            color: #f9fafb !important;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            white-space: nowrap;
            line-height: 1.2;
        }

        .table tbody td {
            font-size: 14px;
            line-height: 1.35;
            white-space: nowrap;
        }

        .table tbody tr:hover > * {
            background-color: #f8fafc;
        }

        .table td.text-wrap,
        .table .cell-wrap {
            white-space: normal;
            min-width: 220px;
        }

        .table .cell-strong {
            font-weight: 700;
            color: var(--text-main);
        }

        .table .cell-muted {
            color: var(--text-muted);
            font-size: 12px;
        }

        .table .cell-money {
            color: var(--success);
            font-weight: 700;
            text-align: right;
            white-space: nowrap;
        }

        .table .cell-date {
            color: #374151;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        .table .cell-actions {
            white-space: nowrap;
            text-align: center;
        }

        .table .cell-actions .btn,
        .table td:last-child .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            white-space: nowrap;
        }

        .badge {
            border-radius: 999px;
            font-weight: 700;
            padding: .42rem .62rem;
        }

        .badge.bg-info {
            background-color: #ccfbf1 !important;
            color: #134e4a !important;
        }

        .badge.bg-success {
            background-color: #dcfce7 !important;
            color: #166534 !important;
        }

        .badge.bg-danger {
            background-color: #fee2e2 !important;
            color: #991b1b !important;
        }

        .badge.bg-warning {
            background-color: #fef3c7 !important;
            color: #92400e !important;
        }

        .badge.bg-secondary {
            background-color: #e5e7eb !important;
            color: #374151 !important;
        }

        .modal-content {
            border: 0;
            border-radius: 8px;
            overflow: hidden;
        }

        .footer {
            height: 50px;
            background: var(--surface);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: var(--text-muted);
        }

        .profile-avatar {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            background: var(--primary);
            color: white;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: fixed;
                top: 0;
                left: -280px;
                height: 100vh;
                z-index: 1100;
            }

                .sidebar.open {
                    left: 0;
                }

            .mobile-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 23, 42, 0.6);
                z-index: 1000;
                display: none;
            }

                .mobile-overlay.show {
                    display: block;
                }

            .content {
                padding: 18px;
            }

            .topbar {
                padding: 0 16px;
            }

            .page-title {
                font-size: 17px;
            }

            .table > :not(caption) > * > * {
                padding: 11px 12px;
            }
        }
    </style>
</head>
<body>

    <div class="mobile-overlay" id="overlay" onclick="closeSidebar()"></div>

    <div class="layout">

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Super Admin</span>
            </div>

            <nav class="nav">
                <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>

                <div class="nav-section-title">Business</div>
                <a href="@Url.Action("AddBusiness", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-plus-circle"></i> Add Business
                </a>
                <a href="@Url.Action("Business", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-building"></i> Manage Businesses
                </a>

                <div class="nav-section-title">Organisation</div>
                <a href="@Url.Action("AddCommunity", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-plus"></i> Add Organisation
                </a>
                <a href="@Url.Action("ManageCommunity", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-sitemap"></i> Manage Organisations
                </a>

                <div class="nav-section-title">Organisation</div>
                <a href="@Url.Action("AddCharityItem", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-hand-holding-heart"></i> Add Charity Item
                </a>
                <a href="@Url.Action("CharityItems", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-box-open"></i> Charity Items
                </a>

                <div class="nav-section-title">Users</div>
                <a href="@Url.Action("Users", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-users"></i> All Users
                </a>
              @*   <a href="@Url.Action("BlockedUsers", "User", new { area = "Admin" })">
                    <i class="fa-solid fa-user-lock"></i> Blocked Users
                </a> *@ 

                <div class="nav-section-title">Games</div>
                <a href="@Url.Action("TextQuizList", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-concierge-bell"></i> Text Quiz
                </a>
                <a href="@Url.Action("SmartQuizList", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-concierge-bell"></i> Smart Quiz
                </a>
                <a href="@Url.Action("QuizGameplays", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-trophy"></i> Gameplays & Winners
                </a>
                <a href="@Url.Action("Index", "SpinGame", new { area = "Admin" })">
                    <i class="fa-solid fa-concierge-bell"></i> Spin Game
                </a>
                <a href="@Url.Action("Index", "Game", new { area = "Admin" })">
                    <i class="fa-solid fa-concierge-bell"></i> Brand Game
                </a>


                <div class="nav-section-title">Communication</div>
                <a href="@Url.Action("Communication", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-bell"></i> Send Notification
                </a>
               @*  <a href="@Url.Action("Broadcast", "Communication", new { area = "Admin" })">
                    <i class="fa-solid fa-bullhorn"></i> Broadcast Message
                </a>
                <a href="@Url.Action("EmailUsers", "Communication", new { area = "Admin" })">
                    <i class="fa-solid fa-envelope"></i> Email Users
                </a> *@

                <div class="nav-section-title">Management</div>
                <a href="@Url.Action("Promotions", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-tags"></i> Promotions
                </a>
                <a href="@Url.Action("LiveAuctions", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-gavel"></i> Live Auctions
                </a>
                <a href="@Url.Action("Services", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-concierge-bell"></i> Services
                </a>
                <a href="@Url.Action("AddService", "Admin", new { area = "Admin" })">
                    <i class="fa-solid fa-concierge-bell"></i> Add Service
                </a>

                <div class="nav-section-title">Talent Show</div>
                <a href="@Url.Action("Campaigns", "Admin", new { area = "TalentShow" })">
                    <i class="fa-solid fa-calendar-days"></i> Campaigns
                </a>
                <a href="@Url.Action("CampaignForm", "Admin", new { area = "TalentShow" })">
                    <i class="fa-solid fa-calendar-plus"></i> Add Campaign
                </a>
                <a href="@Url.Action("Categories", "Admin", new { area = "TalentShow" })">
                    <i class="fa-solid fa-list"></i> Categories
                </a>
                <a href="@Url.Action("CategoryForm", "Admin", new { area = "TalentShow" })">
                    <i class="fa-solid fa-folder-plus"></i> Add Category
                </a>
                <a href="@Url.Action("AddVideo", "Admin", new { area = "TalentShow" })">
                    <i class="fa-solid fa-video"></i> Add Video
                </a>
                <a href="@Url.Action("Videos", "Admin", new { area = "TalentShow" })">
                    <i class="fa-solid fa-photo-film"></i> Video List
                </a>
                <a href="@Url.Action("Rankings", "Admin", new { area = "TalentShow" })">
                    <i class="fa-solid fa-ranking-star"></i> Rankings
                </a>

                <a href="@Url.Action("Reports", "Reports", new { area = "Admin" })">
                    <i class="fa-solid fa-chart-pie"></i> Reports
                </a>
                <a href="@Url.Action("Settings", "Settings", new { area = "Admin" })">
                    <i class="fa-solid fa-gear"></i> Settings
                </a>
            
            </nav>

            <div class="mt-auto">
                <a href="@Url.Action("Logout", "Admin", new { area = "Admin" })"
                   class="nav-link text-danger fw-bold d-flex align-items-center gap-2 px-3">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </a>
            </div>
        </aside>

        <!-- Main -->
        <div class="main">

            <!-- Topbar -->
            <header class="topbar">
                <div class="top-left">
                    <button class="menu-btn" onclick="toggleSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <span class="page-title">@ViewData["Title"]</span>
                </div>

                <div class="top-actions">
                    <button class="notification-btn">
                        <i class="fa-solid fa-bell"></i>
                    </button>

                    <div class="dropdown">
                        <button class="btn btn-light d-flex align-items-center gap-2 fw-bold"
                                data-bs-toggle="dropdown">
                            <div class="profile-avatar">@adminInitial</div>
                            @adminName
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">My Profile</a></li>
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger"
                                   href="@Url.Action("Logout", "Admin", new { area = "Admin" })">
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <main class="content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer">
                © 2026 CommUnity Super Admin Portal. All rights reserved.
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("overlay");

        function toggleSidebar() {
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle("open");
                overlay.classList.toggle("show");
            } else {
                sidebar.classList.toggle("collapsed");
            }
        }

        function closeSidebar() {
            sidebar.classList.remove("open");
            overlay.classList.remove("show");
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
