@model IEnumerable<CommUnityApp.ApplicationCore.Models.ScratchWinGameDto>
@{
    ViewData["Title"] = "Scratch & Win Games";
    Layout = "AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-800 mb-1"><i class="fa-solid fa-gift text-primary me-2"></i>Scratch & Win Games</h2>
            <p class="text-muted">Manage Scratch & Win campaigns, configure dynamic prizes, coins, and win probabilities.</p>
        </div>
        <a href="@Url.Action("Create", "ScratchWin", new { area = "Admin" })" class="btn btn-primary rounded-pill px-4 fw-600 shadow-sm">
            <i class="fa-solid fa-plus me-2"></i> Create New Scratch Game
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 border-0">Game Info</th>
                        <th class="border-0">Schedule</th>
                        <th class="border-0">Rules</th>
                        <th class="border-0">Entries</th>
                        <th class="border-0">Status</th>
                        <th class="border-0 pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var game in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3 text-primary">
                                            <i class="fa-solid fa-ticket fa-2x"></i>
                                        </div>
                                        <div>
                                            <div class="fw-700 text-dark">@game.GameName</div>
                                            <div class="text-muted small">@game.GameTitle</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-600">@game.StartDate.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">to @game.EndDate.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td>
                                    <div class="small"><span class="fw-600">Chances:</span> @game.ChanceCount/day</div>
                                    <div class="text-muted small"><span class="fw-600">Once in:</span> @game.OnceIn plays</div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-700">
                                        <i class="fa-solid fa-users me-1"></i> @game.TotalEntries Plays
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(game.Status == 1 ? "bg-success-subtle text-success" : "bg-secondary-subtle text-muted") rounded-pill px-3 py-2 fw-600"> 
                                        @(game.Status == 1 ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-icon btn-light rounded-circle shadow-none" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa-solid fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3">
                                            <li>
                                                <a class="dropdown-item py-2" href="@Url.Action("Create", "ScratchWin", new { area = "Admin", gameId = game.GameId })">
                                                    <i class="fa-solid fa-pen-to-square me-2 text-primary"></i> Edit & Configure Prizes
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2" href="#" onclick="toggleStatus(@game.GameId)">
                                                    <i class="fa-solid fa-power-off me-2 text-warning"></i> Toggle Status
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item py-2 text-danger" href="#" onclick="deleteGame(@game.GameId)">
                                                    <i class="fa-solid fa-trash-can me-2"></i> Delete
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-5 text-center">
                                <div class="opacity-40 mb-3">
                                    <i class="fa-solid fa-ticket fa-4x text-muted"></i>
                                </div>
                                <h5 class="fw-700 text-muted">No Scratch & Win Games Found</h5>
                                <p class="text-muted mb-4">Create your first Scratch & Win game with dynamic prizes and coins.</p>
                                <a href="@Url.Action("Create", "ScratchWin", new { area = "Admin" })" class="btn btn-primary rounded-pill px-4 fw-600">
                                    Create New Scratch Game
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleStatus(id) {
        if (!confirm('Are you sure you want to change the status of this game?')) return;
        fetch(`/Admin/ScratchWin/ToggleStatus/${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.resultId === 1) {
                    location.reload();
                } else {
                    alert(data.resultMessage || 'Failed to update status.');
                }
            })
            .catch(err => alert('Network error occurred.'));
    }

    function deleteGame(id) {
        if (!confirm('Are you sure you want to delete this game?')) return;
        fetch(`/Admin/ScratchWin/Delete/${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.resultId === 1) {
                    location.reload();
                } else {
                    alert(data.resultMessage || 'Failed to delete game.');
                }
            })
            .catch(err => alert('Network error occurred.'));
    }
</script>
