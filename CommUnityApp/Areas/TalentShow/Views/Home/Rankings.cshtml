@{
    ViewData["Title"] = "Talent Campaign Rankings";
    Layout = "~/Areas/Community/Views/Shared/_CommunityLayout.cshtml";
}

<style>
    .ranking-shell {
        max-width: 1120px;
    }

    .ranking-title {
        color: #0f172a;
        font-size: 28px;
        font-weight: 900;
        margin: 0;
    }

    .ranking-panel,
    .ranking-filter {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
    }

    .ranking-filter {
        display: grid;
        gap: 12px;
        grid-template-columns: minmax(180px, 260px) minmax(180px, 260px) minmax(140px, 180px) auto;
        margin-bottom: 18px;
        padding: 14px;
    }

    .rank-badge {
        align-items: center;
        background: #0f766e;
        border-radius: 999px;
        color: #fff;
        display: inline-flex;
        font-weight: 900;
        height: 34px;
        justify-content: center;
        width: 34px;
    }

    @@media (max-width: 820px) {
        .ranking-filter {
            display: flex;
            flex-direction: column;
        }
    }
</style>

<div class="ranking-shell">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="ranking-title">Talent Campaign Rankings</h1>
            <div class="text-muted">Category-wise ranking after judge, viewer, engagement, and consistency scores are combined.</div>
        </div>
        <div class="d-flex gap-2">
            <a href="/TalentShow/Home/Campaign" class="btn btn-outline-primary">Campaign Flow</a>
            <a href="/TalentShow/Home/Gallery" class="btn btn-outline-secondary">Gallery</a>
        </div>
    </div>

    <div class="ranking-filter">
        <select id="campaignFilter" class="form-select">
            <option value="">All campaigns</option>
        </select>
        <select id="categoryFilter" class="form-select">
            <option value="">All categories</option>
        </select>
        <select id="ageGroupFilter" class="form-select">
            <option value="">All ages</option>
            <option value="Under 8">Under 8</option>
            <option value="8-12">8-12</option>
            <option value="13-17">13-17</option>
            <option value="18+">18+</option>
        </select>
        <button id="applyBtn" class="btn btn-primary" type="button">Apply</button>
    </div>

    <div class="ranking-panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 82px;">Rank</th>
                        <th>Member</th>
                        <th style="width: 150px;">Category</th>
                        <th style="width: 110px;">Age</th>
                        <th style="width: 120px;">Judge</th>
                        <th style="width: 120px;">Viewer</th>
                        <th style="width: 130px;">Engagement</th>
                        <th style="width: 130px;">Consistency</th>
                        <th style="width: 120px;">Final</th>
                    </tr>
                </thead>
                <tbody id="rankingRows">
                    <tr><td colspan="9" class="text-center text-muted py-4">Loading rankings...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", async () => {
        await loadCampaigns();
        await loadCategories();
        await loadRankings();
    });

    document.getElementById("applyBtn").addEventListener("click", loadRankings);

    async function loadCampaigns() {
        const select = document.getElementById("campaignFilter");
        try {
            const response = await fetch("/api/TalentShow/campaigns");
            const campaigns = await response.json();
            select.innerHTML = "<option value=''>All campaigns</option>" +
                campaigns.map(campaign => `<option value="${campaign.talentShowCampaignId}">${escapeHtml(campaign.campaignName)}</option>`).join("");
        }
        catch {
            select.innerHTML = "<option value=''>All campaigns</option>";
        }
    }

    async function loadCategories() {
        const select = document.getElementById("categoryFilter");
        try {
            const response = await fetch("/api/TalentShow/categories");
            const categories = await response.json();
            select.innerHTML = "<option value=''>All categories</option>" +
                categories.map(category => `<option value="${category.talentShowCategoryId}">${escapeHtml(category.categoryName)}</option>`).join("");
        }
        catch {
            select.innerHTML = "<option value=''>All categories</option>";
        }
    }

    async function loadRankings() {
        const tbody = document.getElementById("rankingRows");
        const params = new URLSearchParams();
        const campaignId = document.getElementById("campaignFilter").value;
        const categoryId = document.getElementById("categoryFilter").value;
        const ageGroup = document.getElementById("ageGroupFilter").value;

        if (campaignId) params.append("talentShowCampaignId", campaignId);
        if (categoryId) params.append("talentShowCategoryId", categoryId);
        if (ageGroup) params.append("ageGroup", ageGroup);

        tbody.innerHTML = "<tr><td colspan='9' class='text-center text-muted py-4'>Loading rankings...</td></tr>";

        try {
            const response = await fetch(`/api/TalentShow/rankings?${params.toString()}`);
            const rankings = await response.json();

            if (!Array.isArray(rankings) || rankings.length === 0) {
                tbody.innerHTML = "<tr><td colspan='9' class='text-center text-muted py-4'>No rankings found</td></tr>";
                return;
            }

            tbody.innerHTML = rankings.map(renderRankingRow).join("");
        }
        catch {
            tbody.innerHTML = "<tr><td colspan='9' class='text-center text-danger py-4'>Unable to load rankings</td></tr>";
        }
    }

    function renderRankingRow(item) {
        return `
            <tr>
                <td><span class="rank-badge">${item.rankNumber}</span></td>
                <td>
                    <div class="fw-semibold">${escapeHtml(item.memberName ?? "Community member")}</div>
                    <div class="text-muted small">${escapeHtml(item.campaignName)}</div>
                    <div class="text-muted small">${item.completedChallenges || 0} of 3 challenges</div>
                </td>
                <td>${escapeHtml(item.categoryName)}</td>
                <td>${escapeHtml(item.ageGroup || "")}</td>
                <td>${formatNumber(item.judgeScore)}</td>
                <td>${formatNumber(item.viewerRating)} / 5</td>
                <td>${formatNumber(item.engagementScore)}</td>
                <td>${formatNumber(item.consistencyScore)}%</td>
                <td class="fw-bold">${formatNumber(item.finalScore)}</td>
            </tr>
        `;
    }

    function formatNumber(value) {
        return Number(value || 0).toFixed(1);
    }

    function escapeHtml(value) {
        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }
</script>
