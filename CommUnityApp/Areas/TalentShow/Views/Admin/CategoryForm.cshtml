@{
    ViewData["Title"] = "Talent Show Category";
    Layout = "~/Areas/Admin/Views/shared/AdminLayout.cshtml";
    var talentShowCategoryId = ViewBag.TalentShowCategoryId ?? 0;
}

<style>
    .form-shell {
        max-width: 820px;
    }

    .form-panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
        padding: 24px;
    }

    .form-title {
        color: #0f172a;
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 4px;
    }
</style>

<div class="form-shell">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="form-title" id="pageHeading">Add Category</h1>
            <div class="text-muted">Keep categories concise so members can choose quickly.</div>
        </div>

        <a href="/TalentShow/Admin/Categories" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Back
        </a>
    </div>

    <div class="form-panel">
        <div id="result"></div>

        <form id="categoryForm">
            <input type="hidden" id="talentShowCategoryId" value="@talentShowCategoryId" />

            <div class="mb-3">
                <label class="form-label">Category Name</label>
                <input type="text" id="categoryName" class="form-control" maxlength="100" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea id="description" class="form-control" rows="4" maxlength="500"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Display Order</label>
                    <input type="number" id="displayOrder" class="form-control" min="0" value="0" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Status</label>
                    <select id="isActive" class="form-select">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-success">
                <i class="fa-solid fa-floppy-disk"></i>
                Save Category
            </button>
        </form>
    </div>
</div>

<script>
    const categoryId = Number(document.getElementById("talentShowCategoryId").value || 0);

    document.addEventListener("DOMContentLoaded", () => {
        if (categoryId > 0) {
            document.getElementById("pageHeading").textContent = "Edit Category";
            loadCategory(categoryId);
        }
    });

    document.getElementById("categoryForm").addEventListener("submit", async event => {
        event.preventDefault();

        const payload = {
            talentShowCategoryId: categoryId,
            categoryName: document.getElementById("categoryName").value.trim(),
            description: document.getElementById("description").value.trim(),
            displayOrder: Number(document.getElementById("displayOrder").value || 0),
            isActive: document.getElementById("isActive").value === "true"
        };

        const resultBox = document.getElementById("result");

        try {
            const response = await fetch("/api/TalentShow/categories/save", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            const result = await response.json();

            if (result.resultId > 0) {
                resultBox.innerHTML = `<div class="alert alert-success">${escapeHtml(result.resultMessage)}</div>`;
                window.setTimeout(() => window.location.href = "/TalentShow/Admin/Categories", 700);
            }
            else {
                resultBox.innerHTML = `<div class="alert alert-danger">${escapeHtml(result.resultMessage ?? "Unable to save category")}</div>`;
            }
        }
        catch {
            resultBox.innerHTML = "<div class='alert alert-danger'>Unable to save category</div>";
        }
    });

    async function loadCategory(id) {
        const response = await fetch(`/api/TalentShow/categories/${id}`);
        if (!response.ok) return;

        const category = await response.json();
        document.getElementById("categoryName").value = category.categoryName ?? "";
        document.getElementById("description").value = category.description ?? "";
        document.getElementById("displayOrder").value = category.displayOrder ?? 0;
        document.getElementById("isActive").value = category.isActive ? "true" : "false";
    }

    function escapeHtml(value) {
        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }
</script>
