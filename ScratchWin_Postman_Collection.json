	},
	"item": [
		{
			"name": "1. Reveal Prize (SubmitBrandGame)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"gameId\": 1,\n    \"userId\": \"d290f1ee-6c54-4b01-90e6-d701748f0851\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/Game/SubmitBrandGame",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"Game",
						"SubmitBrandGame"
					]
				},
				"description": "Calls the backend to execute a secure probability roll and reveal the won prize category. Returns a signed verificationToken."
			},
			"response": []
		},
		{
			"name": "2. Claim / Redeem Prize (RedeemPrize)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"gameId\": 1,\n    \"userId\": \"d290f1ee-6c54-4b01-90e6-d701748f0851\",\n    \"prizeType\": \"PrimaryPrize\",\n    \"attemptNumber\": 1,\n    \"verificationToken\": \"<Paste verificationToken from SubmitBrandGame response>\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/Game/RedeemPrize",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"Game",
						"RedeemPrize"
					]
				},
				"description": "Verifies the signed token, decrements stock for physical prizes, writes the gameplay to history, adds coins to the user's wallet, and generates QR/Redeem codes only for physical prizes."
			},
			"response": []
		}
	],
